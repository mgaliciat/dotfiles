#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════
#  theme — switcher del "tema del stack"
#
#  Voltea Ghostty + nvim + tmux a un mismo tema escribiendo tres punteros
#  VERSIONADOS. Starship se adapta solo vía ANSI, no necesita puntero. Las
#  DEFINICIONES de paleta están versionadas (ghostty/themes/,
#  nvim/lua/themes/, tmux/themes/); acá solo elegimos cuál está activa.
#
#  La selección viaja en git (a diferencia de ~/.zshrc.local y compañía):
#  cambiar de tema ensucia el working tree y hay que COMMITEAR para que un
#  `git pull` lo propague a las otras máquinas. Es deliberado — antes los
#  punteros eran *.local y el tema nunca viajaba.
#
#  Uso:
#    theme <id>     aplica el tema a las 3 capas
#    theme list     lista la familia
#    theme          muestra la selección actual
#
#  Familia canónica: dark-2026 (default) · light-2026 · osaka · oled-neon
#                    · carbon · anthropic-dark · anthropic-warm
#                    · prism-night · paper · solarized-light
#  Alias osaka (sub-sabores del plugin, no entradas de la matriz):
#    solarized-osaka, osaka-moon, osaka-storm, osaka-day
#
#  Reload: tmux se re-sourcea en vivo si hay server corriendo. Ghostty y
#  nvim toman el tema al reabrir/reiniciar (decisión de diseño: sin push
#  a instancias vivas). En Linux/WSL2 sin Ghostty, ese paso se omite.
# ═══════════════════════════════════════════════════════════════

set -euo pipefail

FAMILY="light-2026 dark-2026 osaka oled-neon carbon anthropic-dark anthropic-warm prism-night paper solarized-light"

# Punteros de selección. VERSIONADOS (no son *.local): viven dentro del
# repo vía los symlinks de dir (~/.config/{ghostty/themes,nvim,tmux} →
# dotfiles/), así que escribirlos acá ensucia el working tree y hay que
# commitearlos para que el tema viaje a las otras máquinas. Escribimos por
# el path ~/.config a propósito: son archivos regulares dentro de un dir
# symlinkeado, así que no hay riesgo de clobberear un symlink.
GHOSTTY_POINTER="$HOME/.config/ghostty/themes/current"
NVIM_POINTER="$HOME/.config/nvim/lua/theme-current"
TMUX_POINTER="$HOME/.config/tmux/theme-current.conf"

# Punteros de la era per-máquina (gitignored). Ya nadie los lee — ningún
# config los referencia —, pero borrarlos evita que alguien los edite
# esperando que sigan haciendo algo.
LEGACY_POINTERS=(
  "$HOME/.config/ghostty/themes/current.local"
  "$HOME/.config/nvim/lua/theme-current.local"
  "$HOME/.config/tmux/current.local"
)

# Resuelve un id (canónico o alias) → G (ghostty theme), N (nvim theme),
# T (archivo de paleta tmux). Devuelve 1 si el id no existe.
resolve() {
  case "$1" in
    light-2026)      G=light-2026;      N=light-2026;      T=light-2026 ;;
    dark-2026)       G=dark-2026;       N=dark-2026;       T=dark-2026 ;;
    osaka|solarized-osaka)             G=solarized-osaka; N=solarized-osaka;       T=osaka ;;
    osaka-moon|solarized-osaka-moon)   G=solarized-osaka; N=solarized-osaka-moon;  T=osaka ;;
    osaka-storm|solarized-osaka-storm) G=solarized-osaka; N=solarized-osaka-storm; T=osaka ;;
    osaka-day|solarized-osaka-day)     G=solarized-osaka; N=solarized-osaka-day;   T=osaka ;;
    oled-neon)       G=oled-neon;      N=oled-neon;      T=oled-neon ;;
    carbon)          G=carbon;         N=carbon;         T=carbon ;;
    anthropic-dark)  G=anthropic-dark; N=anthropic-dark; T=anthropic-dark ;;
    anthropic-warm)  G=anthropic-warm; N=anthropic-warm; T=anthropic-warm ;;
    prism-night)     G=prism-night;    N=prism-night;    T=prism-night ;;
    paper)           G=paper;          N=paper;          T=paper ;;
    solarized-light) G=solarized-light; N=solarized-light; T=solarized-light ;;
    *) return 1 ;;
  esac
}

list_family() {
  echo "Familia del stack:"
  for t in $FAMILY; do echo "  · $t"; done
  echo "Alias osaka: solarized-osaka, osaka-moon, osaka-storm, osaka-day"
}

show_current() {
  echo "Selección actual (punteros versionados):"
  # `${var:-(malformed)}` cubre el caso de un puntero corrupto/vacío: sin
  # esto el output mostraría "  nvim →" sin valor, confuso de diagnosticar.
  local v
  if [[ -f "$NVIM_POINTER" ]]; then
    v=$(tr -d '[:space:]' < "$NVIM_POINTER")
    echo "  nvim    → ${v:-(malformed)}"
  else
    echo "  nvim    → (default versionado: dark-2026)"
  fi
  if [[ -f "$GHOSTTY_POINTER" ]]; then
    v=$(sed -n 's/^theme = //p' "$GHOSTTY_POINTER")
    echo "  ghostty → ${v:-(malformed)}"
  else
    echo "  ghostty → (default versionado: dark-2026)"
  fi
  if [[ -f "$TMUX_POINTER" ]]; then
    v=$(sed -n 's#.*themes/\(.*\)\.conf#\1#p' "$TMUX_POINTER")
    echo "  tmux    → ${v:-(malformed)}"
  else
    echo "  tmux    → (default versionado: dark-2026)"
  fi
}

apply_theme() {
  local id="$1"
  if ! resolve "$id"; then
    echo "theme: '$id' no es un tema válido." >&2
    echo "" >&2
    list_family >&2
    exit 1
  fi

  local changed=()

  # Barrido de la era per-máquina. Inertes (nadie los sourcea), pero un
  # `current.local` con otro tema al lado del puntero real es una trampa.
  rm -f "${LEGACY_POINTERS[@]}"

  # ─── Ghostty ───  (skip silencioso si no está presente — Linux/WSL2)
  if [[ -d "$HOME/.config/ghostty" ]]; then
    mkdir -p "$(dirname "$GHOSTTY_POINTER")"
    printf 'theme = %s\n' "$G" > "$GHOSTTY_POINTER"
    changed+=("ghostty=$G")
  fi

  # ─── nvim ───
  if [[ -d "$HOME/.config/nvim/lua" ]]; then
    mkdir -p "$(dirname "$NVIM_POINTER")"
    printf '%s\n' "$N" > "$NVIM_POINTER"
    changed+=("nvim=$N")
  fi

  # ─── tmux ───
  if [[ -d "$HOME/.config/tmux" ]]; then
    mkdir -p "$(dirname "$TMUX_POINTER")"
    printf 'source ~/.config/tmux/themes/%s.conf\n' "$T" > "$TMUX_POINTER"
    changed+=("tmux=$T")
  fi

  echo "✓ tema → $id  (${changed[*]})"

  # ─── reloads ───
  # tmux: re-sourcea en vivo si hay server (barato y robusto). El chain
  # re-aplica paleta default → theme-current.conf → estructura (re-hornea).
  if command -v tmux >/dev/null 2>&1 && tmux info >/dev/null 2>&1; then
    # Sin 2>/dev/null: un error al re-sourcear el tema debe verse.
    if tmux source-file "$HOME/.config/tmux/tmux.conf"; then
      echo "  ✓ tmux recargado en vivo"
    fi
  fi
  # Ghostty y nvim: aplican al reabrir.
  echo "  → Ghostty: reabrí la ventana o recargá con ⌘⇧R"
  echo "  → nvim:    reiniciá nvim (o :source \$MYVIMRC + :colorscheme)"
  # Los punteros son versionados: sin commit el tema no llega a las otras
  # máquinas. Es el paso que más se olvida, así que lo decimos siempre.
  echo "  → git:     commiteá los punteros para propagar el tema"
}

case "${1:-}" in
  "")          show_current ;;
  list|--list) list_family ;;
  # Imprime el header doc-block (entre las dos líneas `# ═══`) sin números
  # de línea hardcodeados, robusto ante ediciones. ${BASH_SOURCE[0]} en vez
  # de $0 por si el script se sourcea en algún contexto.
  -h|--help)   sed -n '/^# ═══/,/^# ═══/p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' ;;
  *)           apply_theme "$1" ;;
esac
