#!/usr/bin/env bash
# ─── scripts/ide — IDE-style tmux layout ──────────────────────
# Adapted from craftzdog/dotfiles-public/.scripts/ide.
#
# The layout it builds — 4 panes (seen from above):
#
#   ┌──────────────┬───────────────────┬──────────┐
#   │              │                   │          │
#   │  main (top-  │   pane right      │ sidebar  │
#   │  left, stays │                   │   20%    │
#   │  active)     │                   │          │
#   ├──────────────┴───────────────────┤ (full    │
#   │                                  │  height) │
#   │         terminal (30%)           │          │
#   └──────────────────────────────────┴──────────┘
#
# Usage: inside a tmux session, run:
#   ~/dotfiles/scripts/ide
# Or add it to your PATH with:
#   ln -s ~/dotfiles/scripts/ide ~/.local/bin/ide
# And then just: `ide`
#
# If you're not in tmux, it warns you and exits.

if [[ -z "${TMUX:-}" ]]; then
  echo "Error: this script must be run inside a tmux session."
  echo "Start tmux first with: tmux new -s project"
  exit 1
fi

# Right sidebar (20%)
tmux split-window -h -l 20%

# Back to the left pane
tmux select-pane -L

# Terminal at the bottom (30% of the left pane)
tmux split-window -v -l 30%

# In the "main" pane (top-left), split it into two columns
tmux select-pane -U
tmux split-window -h -l 50%

# Back to the main pane (top-left) so it's the active one when done
tmux select-pane -L
tmux select-pane -U
