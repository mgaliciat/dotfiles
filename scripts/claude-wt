#!/usr/bin/env bash
# ─── scripts/claude-wt — pick a worktree, run Claude Code in it ──
#
#   claude-wt [--api] [claude args...]
#
# From anywhere inside a git repo (the main checkout, a linked worktree, a
# subdirectory of either): lists the repo's worktrees, and on a pick cd's to
# that worktree's root and execs `claude` there, with the remaining args.
# `claude-wt -c` resumes the last conversation of the worktree you pick.
#
# THE PICKER IS fzf, which both installers already install (and which the
# gco/dex functions lean on): Enter launches, Ctrl-D deletes, Esc / Ctrl-C
# cancels, and the preview shows `git status -sb` plus the last commits of the
# highlighted one. Without fzf on PATH it falls back to a numbered prompt in
# plain bash (`3` launches, `d3` deletes), so a box mid-bootstrap still gets a
# working command instead of a dependency error.
#
# DELETING is `git worktree remove` after a y/N confirmation, then back to the
# list. git's own refusals are the safety net and are surfaced, not bypassed:
# with uncommitted or untracked files, or a lock, it says why and asks a second
# time before forcing (--force twice, which also overrides the lock). Then it
# offers to delete the branch too, with `git branch -d` only: an unmerged
# branch is kept and reported, never force-deleted from here. Refused outright:
#   - the main worktree (git cannot remove it; it IS the repo);
#   - the worktree you ran this from: the shell you return to would be sitting
#     in a deleted directory. cd out of it first.
#
# ONLY ONE WORKTREE (the usual repo): there is nothing to pick, so it says so
# and launches in it directly — the same as fzf's --select-1, and what the
# command is for. Run from a subdirectory, that still lands at the root. That
# shortcut applies on the first listing only: after a delete leaves one, the
# list is shown again rather than launching Claude unasked.
#
# NOT LISTED: the bare entry of a bare repo (no working tree to run in) and
# prunable ones (directory gone, `git worktree prune` cleans them up). Locked
# worktrees are listed and marked: the lock only guards against pruning.
#
# `--api` IS ONLY RECOGNISED AS THE FIRST ARGUMENT, same rule and same reason
# as the `claude --api` wrapper in zsh/functions.zsh: it goes through
# scripts/claude-api-env. That wrapper is a zsh function, so it does not exist
# here — a script never sees .zshrc — hence the flag is handled again rather
# than inherited.
#
# A SCRIPT CANNOT CHANGE ITS PARENT SHELL'S DIRECTORY. The cd happens in this
# process, which then becomes `claude` (exec): Claude runs in the worktree, and
# when it exits you are back where you started. That is the point — a session
# per worktree without losing your place.
#
# Plain bash 3.2 (macOS /bin/bash): no mapfile, no associative arrays.
# Porcelain without -z (git 2.36+; Ubuntu 22.04 ships 2.34), so a path with a
# newline in it is not supported.
set -euo pipefail

die() {
  echo "claude-wt: $1" >&2
  exit 1
}

usage() {
  cat <<'EOF'
usage: claude-wt [--api] [claude args...]

Pick one of this repo's git worktrees and run Claude Code in it.
  Enter    launch claude in the highlighted worktree
  Ctrl-D   delete the highlighted worktree (asks first)
  Esc      cancel
  --api    launch through claude-api-env (first argument only)
EOF
}

api=0
case ${1:-} in
  -h | --help) usage; exit 0 ;;
  --api) api=1; shift ;;
esac

# --git-dir rather than --is-inside-work-tree: it also answers from inside .git
# or a bare repo, where `git worktree list` works just as well.
git rev-parse --git-dir >/dev/null 2>&1 \
  || die "not inside a git repository ($PWD) — cd into one first"

if (( api )); then
  command -v claude-api-env >/dev/null 2>&1 \
    || die "--api needs claude-api-env on PATH (run ./install.sh)"
else
  command -v claude >/dev/null 2>&1 || die "claude is not on PATH"
fi

# Empty in a bare repo or inside .git; that only means no entry is marked.
here=$(git rev-parse --show-toplevel 2>/dev/null || true)

# ── parse `git worktree list --porcelain` ────────────────────
# One block per worktree, blank-line separated: `worktree <path>`, then
# `HEAD <sha>`, `branch refs/heads/<name>` or `detached`, and optional `bare`,
# `locked [reason]`, `prunable [reason]`. Kept as parallel indexed arrays;
# branches[] is empty for a detached one. The FIRST block is always the main
# worktree (or the bare repo), which is what main_path records.
flush() {
  if [[ -n $path ]] && (( ! skip )) && [[ -d $path ]]; then
    paths+=("$path")
    labels+=("$label")
    branches+=("$branch")
    flags+=("$flag")
  fi
  path='' label='' branch='' flag='' skip=0
}

load() {
  paths=() labels=() branches=() flags=()
  path='' label='' branch='' flag='' skip=0 main_path=''
  local line
  while IFS= read -r line || [[ -n $line ]]; do
    case $line in
      'worktree '*)
        flush
        path=${line#worktree }
        [[ -n $main_path ]] || main_path=$path ;;
      'HEAD '*)     label="(detached ${line:5:7})" ;;  # overwritten by `branch` when on one
      'branch '*)   branch=${line#branch refs/heads/}; label=$branch ;;
      bare | 'prunable'*) skip=1 ;;
      'locked'*)    flag="$flag [locked]" ;;
      '') flush ;;
    esac
  done < <(git worktree list --porcelain)
  flush
  n=${#paths[@]}
}

# ── one display line per worktree ────────────────────────────
# `<path>\t<branch>  <~/path>  <marks>`: field 1 is what we act on and is hidden
# from the list (--with-nth), so a path never has to be parsed back out of the
# padded display text.
build_rows() {
  local width=0 l i p shown marks
  for l in "${labels[@]}"; do
    if (( ${#l} > width )); then width=${#l}; fi
  done
  rows=()
  for (( i = 0; i < n; i++ )); do
    p=${paths[i]}
    shown=$p
    if [[ $p == "$HOME"/* ]]; then shown="~${p#"$HOME"}"; fi
    marks=${flags[i]}
    if [[ $p == "$main_path" ]]; then marks=" [main]$marks"; fi
    if [[ $p == "$here" ]]; then marks=" [current]$marks"; fi
    rows+=("$(printf '%s\t%-*s  %s%s' "$p" "$width" "${labels[i]}" "$shown" "$marks")")
  done
}

launch() {
  cd -- "$1" || die "cannot cd to $1"
  echo "→ claude in $1" >&2
  if (( api )); then
    exec claude-api-env claude "${@:2}"
  fi
  exec claude "${@:2}"
}

# y/N from the terminal, not stdin: same reason fzf reads /dev/tty. Anything
# but y/yes is a no, EOF included.
confirm() {
  local answer
  printf '%s [y/N] ' "$1" >&2
  read -r answer </dev/tty || return 1
  [[ $answer == [yY] || $answer == [yY][eE][sS] ]]
}

# Never fatal: every way out returns to the list, so the caller ignores the status.
delete() {
  local p=$1 i br=''
  for (( i = 0; i < n; i++ )); do
    if [[ ${paths[i]} == "$p" ]]; then br=${branches[i]}; fi
  done
  echo >&2
  if [[ $p == "$main_path" ]]; then
    echo "claude-wt: $p is the main worktree — git cannot remove it" >&2
    return 0
  fi
  if [[ $p == "$here" ]]; then
    echo "claude-wt: you are inside $p — cd out of it first, then run claude-wt again" >&2
    return 0
  fi
  confirm "Delete worktree ${br:-(detached)} at $p?" || { echo "kept" >&2; return 0; }
  if ! git worktree remove -- "$p"; then
    confirm "Force it? Uncommitted and untracked files in it are LOST, and a lock is ignored." \
      || { echo "kept" >&2; return 0; }
    git worktree remove --force --force -- "$p" || return 0
  fi
  echo "✓ removed $p" >&2
  if [[ -n $br ]] && confirm "Delete branch $br too?"; then
    # -d, never -D: git refuses an unmerged branch, and that refusal stands.
    git branch -d -- "$br" >&2 || echo "kept branch $br" >&2
  fi
  return 0
}

load
(( n > 0 )) || die "no worktree with a working directory in this repo"

if (( n == 1 )); then
  echo "claude-wt: only one worktree in this repo" >&2
  launch "${paths[0]}" "$@"
fi

# ── the picker, until a launch or a cancel ───────────────────
# After a delete the list is re-read from git, not patched in place: what git
# reports is what was actually removed.
while :; do
  build_rows

  if command -v fzf >/dev/null 2>&1; then
    # --expect prints the key that ended fzf on the first line (empty for
    # Enter), the picked row on the second. Status 1 (no match) and 130
    # (Esc / Ctrl-C) both mean nothing was picked; `|| exit 130` keeps set -e
    # from turning a cancel into an error message.
    # {1} in the preview is the hidden path field, quoted by fzf itself.
    out=$(printf '%s\n' "${rows[@]}" | fzf \
      --delimiter=$'\t' --with-nth=2.. \
      --expect=ctrl-d \
      --prompt='worktree> ' \
      --header='Enter: claude here · Ctrl-D: delete · Esc: cancel' \
      --no-multi --layout=reverse --height=60% \
      --preview='git -C {1} -c color.status=always status -sb; echo; git -C {1} log --oneline --color=always -15' \
      --preview-window='right:45%:wrap') || exit 130
    key=${out%%$'\n'*}
    pick=${out#*$'\n'}
    pick=${pick%%$'\t'*}
  else
    # ── fallback: numbered prompt ──────────────────────────────
    # Read from the terminal, like fzf does, so the prompt still works with
    # stdin redirected. Anything but a valid answer (Enter, q, Esc) cancels.
    for (( i = 0; i < n; i++ )); do
      printf '%2d) %s\n' "$((i + 1))" "${rows[i]#*$'\t'}" >&2
    done
    printf 'worktree [1-%d launches, d1-d%d deletes, anything else cancels]: ' "$n" "$n" >&2
    read -r answer </dev/tty || exit 130
    key=''
    if [[ $answer == d* ]]; then key=ctrl-d; answer=${answer#d}; fi
    if ! [[ $answer =~ ^[0-9]+$ ]] || (( answer < 1 || answer > n )); then exit 130; fi
    pick=${paths[answer - 1]}
  fi

  if [[ $key == ctrl-d ]]; then
    delete "$pick"
    load
    (( n > 0 )) || die "no worktree left with a working directory"
    continue
  fi
  launch "$pick" "$@"
done
