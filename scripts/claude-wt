#!/usr/bin/env bash
# ─── scripts/claude-wt — pick a worktree, run Claude Code in it ──
#
#   claude-wt [--api] [claude args...]
#
# From anywhere inside a git repo (the main checkout, a linked worktree, a
# subdirectory of either): lists the repo's worktrees, and on a pick cd's to
# that worktree's root and execs `claude` there, with the remaining args.
# `claude-wt -c` resumes the last conversation of the worktree you pick.
#
# THE PICKER IS fzf, which both installers already install (and which the
# gco/dex functions lean on), full screen: Enter launches, Ctrl-D deletes,
# Esc / Ctrl-C cancels. Each row carries what you pick a worktree BY — its
# branch, whether it has uncommitted changes, how far it is ahead/behind its
# upstream, the age of its last commit — and the preview pane expands the
# highlighted one (upstream, changed files, commit graph). That preview is
# this same script, called back by fzf as `claude-wt --preview <path>`.
#
# ALL COLOUR IS ANSI 0-15, never hex or 256: the 16 slots are what the stack
# theme tunes (ghostty/themes/<id>, Windows Terminal), so the picker follows
# `theme <id>` like FZF_DEFAULT_OPTS (zsh/.zshenv) and the statusline do. The
# accent is bright blue (94), the statusline's. NO_COLOR turns it all off.
# Glyphs are plain Unicode (● ✓ ↑ ↓ ±), not Nerd Font codepoints, so a WSL or
# Linux terminal without a patched font draws the same thing.
#
# THE STYLED LAYOUT NEEDS fzf 0.42+ (border labels, --info=inline-right). Brew
# ships current, but Ubuntu 22.04's apt has 0.29: below 0.42 the same rows and
# preview run in a plain frame instead of fzf dying on an unknown option.
# Without fzf on PATH it falls back to a numbered prompt in plain bash (`3`
# launches, `d3` deletes), so a box mid-bootstrap still gets a working command
# instead of a dependency error.
#
# DELETING is `git worktree remove` after a y/N confirmation, then back to the
# list, whose header reports what happened (the full-screen picker would hide
# a line printed before it). git's own refusals are the safety net and are
# surfaced, not bypassed: with uncommitted or untracked files, or a lock, it
# says why and asks a second time before forcing (--force twice, which also
# overrides the lock). Then it offers to delete the branch too, with
# `git branch -d` only: an unmerged branch is kept and reported, never
# force-deleted from here. Refused outright:
#   - the main worktree (git cannot remove it; it IS the repo);
#   - the worktree you ran this from: the shell you return to would be sitting
#     in a deleted directory. cd out of it first;
#   - a worktree that another worktree lives inside (`.claude/worktrees/x`):
#     `git worktree remove` deletes ignored files without asking, the nested
#     checkout is one of them to it, and it would go with its uncommitted work.
# IGNORED FILES are the other thing git removes without a word (`.env`, a
# `.claude/` dir: the global gitignore ignores both), so they are listed
# before the first y/N.
#
# THE LIST IS ALWAYS SHOWN, even with a single worktree: Claude is launched
# only on an explicit Enter, never in a worktree picked by default. No
# --select-1 / auto-launch shortcut, on purpose.
#
# NOT LISTED: the bare entry of a bare repo (no working tree to run in) and
# prunable ones (directory gone, `git worktree prune` cleans them up). Locked
# worktrees are listed and marked: the lock only guards against pruning.
#
# `--api` IS ONLY RECOGNISED AS THE FIRST ARGUMENT, same rule and same reason
# as the `claude --api` wrapper in zsh/functions.zsh: it goes through
# scripts/claude-api-env. That wrapper is a zsh function, so it does not exist
# here — a script never sees .zshrc — hence the flag is handled again rather
# than inherited.
#
# A SCRIPT CANNOT CHANGE ITS PARENT SHELL'S DIRECTORY. The cd happens in this
# process, which then becomes `claude` (exec): Claude runs in the worktree, and
# when it exits you are back where you started. That is the point — a session
# per worktree without losing your place.
#
# Plain bash 3.2 (macOS /bin/bash): no mapfile, no associative arrays.
# Porcelain without -z (git 2.36+; Ubuntu 22.04 ships 2.34), so a path with a
# newline in it is not supported.
set -euo pipefail

# ── palette ──────────────────────────────────────────────────
if [[ -z ${NO_COLOR:-} ]]; then
  R=$'\033[0m' B=$'\033[1m'
  RED=$'\033[31m' GRN=$'\033[32m' YEL=$'\033[33m' MAG=$'\033[35m' CYN=$'\033[36m'
  GRY=$'\033[90m' ACC=$'\033[94m' GITCOLOR=always
else
  R='' B='' RED='' GRN='' YEL='' MAG='' CYN='' GRY='' ACC='' GITCOLOR=never
fi

die() {
  echo "${RED}claude-wt:${R} $1" >&2
  exit 1
}

usage() {
  cat <<'EOF'
usage: claude-wt [--api] [claude args...]

Pick one of this repo's git worktrees and run Claude Code in it.
  Enter    launch claude in the highlighted worktree
  Ctrl-D   delete the highlighted worktree (asks first)
  Esc      cancel
  --api    launch through claude-api-env (first argument only)
EOF
}

# Where a worktree is, shown relative to the directory that holds the main
# one (`dotfiles-wt/feat-x` rather than `~/code/dotfiles-wt/feat-x`): that
# prefix is the same on every row, so it is noise in a narrow column. The
# preview pane carries the full path.
short_path() {
  local base
  base=$(dirname "$main_path")
  if [[ $1 == "$base"/* ]]; then printf '%s' "${1#"$base"/}"; else tildify "$1"; fi
}

tildify() {
  if [[ $1 == "$HOME" || $1 == "$HOME"/* ]]; then
    printf '~%s' "${1#"$HOME"}"
  else
    printf '%s' "$1"
  fi
}

# Seconds → the shortest honest unit: now, 5m, 3h, 2d, 6w, 4mo, 1y.
age() {
  local s=$(( $(date +%s) - $1 ))
  if   (( s < 60 ));       then printf 'now'
  elif (( s < 3600 ));     then printf '%dm' $(( s / 60 ))
  elif (( s < 86400 ));    then printf '%dh' $(( s / 3600 ))
  elif (( s < 1209600 ));  then printf '%dd' $(( s / 86400 ))
  elif (( s < 5184000 ));  then printf '%dw' $(( s / 604800 ))
  elif (( s < 31536000 )); then printf '%dmo' $(( s / 2592000 ))
  else                          printf '%dy' $(( s / 31536000 ))
  fi
}

# `git status --porcelain=v2 --branch` in one call: sets `dirty` (changed +
# untracked entries) and `ahead`/`behind` (empty with no upstream).
# --no-optional-locks on every status here: a plain `git status` refreshes the
# index and takes index.lock to do it, and the worktrees this lists are the
# ones a Claude session may be committing in right now.
wt_state() {
  local line
  dirty=0 ahead='' behind=''
  while IFS= read -r line; do
    case $line in
      '# branch.ab '*)
        line=${line#\# branch.ab +}
        ahead=${line%% *}
        behind=${line##*-} ;;
      '#'*) ;;
      ?*) dirty=$(( dirty + 1 )) ;;
    esac
  done < <(git --no-optional-locks -C "$1" status --porcelain=v2 --branch 2>/dev/null || true)
}

# ── the preview pane ─────────────────────────────────────────
# fzf runs this for the highlighted row. Never fails: whatever it prints is
# the pane, so an error is a line in the pane, not a broken picker.
preview() {
  local p=$1 br head up n st first
  cd -- "$p" 2>/dev/null || { echo "${RED}gone:${R} $p"; return 0; }
  br=$(git symbolic-ref --short -q HEAD || true)
  head=$(git rev-parse --short HEAD 2>/dev/null || echo '?')
  first=$(git worktree list --porcelain 2>/dev/null | head -n 1 || true)

  # Same marks as the list: ◆ the main worktree, ● a branch, ◇ detached.
  if [[ $first == "worktree $p" ]]; then
    printf '%s%s◆ %s%s %smain worktree%s\n' "$B" "$MAG" "${br:-$head}" "$R" "$GRY" "$R"
  elif [[ -n $br ]]; then
    printf '%s%s● %s%s\n' "$B" "$ACC" "$br" "$R"
  else
    printf '%s%s◇ detached at %s%s\n' "$B" "$YEL" "$head" "$R"
  fi
  printf '%s%s%s\n' "$GRY" "$(tildify "$p")" "$R"

  wt_state "$p"
  if up=$(git rev-parse --abbrev-ref '@{upstream}' 2>/dev/null); then
    if [[ $ahead == 0 && $behind == 0 ]]; then
      printf '%s✓ up to date%s %swith %s%s\n' "$GRN" "$R" "$GRY" "$up" "$R"
    else
      printf '%s↑%s%s %s↓%s%s %svs %s%s\n' "$CYN" "$ahead" "$R" "$MAG" "$behind" "$R" "$GRY" "$up" "$R"
    fi
  else
    printf '%sno upstream%s\n' "$GRY" "$R"
  fi

  echo
  if (( dirty == 0 )); then
    printf '%sChanges%s\n%s✓ working tree clean%s\n' "$B" "$R" "$GRN" "$R"
  else
    printf '%sChanges%s %s%d%s\n' "$B" "$R" "$YEL" "$dirty" "$R"
    st=$(git --no-optional-locks -c color.status=$GITCOLOR status --short 2>/dev/null || true)
    n=$(printf '%s\n' "$st" | wc -l)
    printf '%s\n' "$st" | head -n 12
    if (( n > 12 )); then printf '%s… %d more%s\n' "$GRY" $(( n - 12 )) "$R"; fi
  fi

  echo
  printf '%sCommits%s\n' "$B" "$R"
  git log --graph --color=$GITCOLOR -n 40 \
    --format='%C(yellow)%h%C(reset) %s %C(brightblack)· %cr%C(auto)%d%C(reset)' 2>/dev/null || true
}

if [[ ${1:-} == --preview ]]; then
  preview "${2:-}"
  exit 0
fi

api=0
case ${1:-} in
  -h | --help) usage; exit 0 ;;
  --api) api=1; shift ;;
esac

# --git-dir rather than --is-inside-work-tree: it also answers from inside .git
# or a bare repo, where `git worktree list` works just as well.
git rev-parse --git-dir >/dev/null 2>&1 \
  || die "not inside a git repository ($PWD) — cd into one first"

if (( api )); then
  command -v claude-api-env >/dev/null 2>&1 \
    || die "--api needs claude-api-env on PATH (run ./install.sh)"
else
  command -v claude >/dev/null 2>&1 || die "claude is not on PATH"
fi

# Empty in a bare repo or inside .git; that only means no entry is marked.
here=$(git rev-parse --show-toplevel 2>/dev/null || true)

# ── parse `git worktree list --porcelain` ────────────────────
# One block per worktree, blank-line separated: `worktree <path>`, then
# `HEAD <sha>`, `branch refs/heads/<name>` or `detached`, and optional `bare`,
# `locked [reason]`, `prunable [reason]`. Kept as parallel indexed arrays;
# branches[] is empty for a detached one. The FIRST block is always the main
# worktree (or the bare repo), which is what main_path records.
flush() {
  if [[ -n $path ]] && (( ! skip )) && [[ -d $path ]]; then
    paths+=("$path")
    labels+=("$label")
    branches+=("$branch")
    locks+=("$locked")
  fi
  path='' label='' branch='' locked=0 skip=0
}

load() {
  paths=() labels=() branches=() locks=()
  path='' label='' branch='' locked=0 skip=0 main_path=''
  local line
  while IFS= read -r line || [[ -n $line ]]; do
    case $line in
      'worktree '*)
        flush
        path=${line#worktree }
        [[ -n $main_path ]] || main_path=$path ;;
      'HEAD '*)     label=${line:5:7} ;;  # overwritten by `branch` when on one
      'branch '*)   branch=${line#branch refs/heads/}; label=$branch ;;
      bare | 'prunable'*) skip=1 ;;
      'locked'*)    locked=1 ;;
      '') flush ;;
    esac
  done < <(git worktree list --porcelain)
  flush
  n=${#paths[@]}
}

# ── one row per worktree ─────────────────────────────────────
#   <path> \t  ● name here    ±3 ↑2 ↓1    2h    repo-wt/name
# Field 1 is what we act on and is hidden from the list (--with-nth), so a
# path never has to be parsed back out of the coloured text. Columns are
# padded on the PLAIN text and coloured after, so escapes never skew widths.
pad() { printf '%*s' $(( $1 > 0 ? $1 : 0 )) ''; }

build_rows() {
  local i p name tags tags_c st st_c ct w_name=0 w_st=0 w_age=0
  local -a names=() tagss=() tagcs=() sts=() stcs=() ages=() icons=()
  for (( i = 0; i < n; i++ )); do
    p=${paths[i]}
    wt_state "$p"

    # ◆ the main worktree, ● a branch, ◇ a detached HEAD.
    if [[ $p == "$main_path" ]]; then icons+=("${MAG}◆${R}")
    elif [[ -n ${branches[i]} ]]; then icons+=("${ACC}●${R}")
    else icons+=("${YEL}◇${R}")
    fi
    if [[ -n ${branches[i]} ]]; then name=${branches[i]}; else name="${labels[i]} detached"; fi

    tags='' tags_c=''
    if [[ $p == "$here" ]];      then tags+=' here'; tags_c+=" ${GRN}here${R}"; fi
    if (( locks[i] ));           then tags+=' locked'; tags_c+=" ${RED}locked${R}"; fi

    if (( dirty > 0 )); then st="±$dirty"; st_c="${YEL}±$dirty${R}"
    else                     st='✓';       st_c="${GRN}✓${R}"; fi
    if [[ -n $ahead && $ahead != 0 ]];   then st+=" ↑$ahead";  st_c+=" ${CYN}↑$ahead${R}"; fi
    if [[ -n $behind && $behind != 0 ]]; then st+=" ↓$behind"; st_c+=" ${MAG}↓$behind${R}"; fi

    ct=$(git -C "$p" log -1 --format=%ct 2>/dev/null || true)
    if [[ -n $ct ]]; then ages+=("$(age "$ct")"); else ages+=('—'); fi

    names+=("$name"); tagss+=("$tags"); tagcs+=("$tags_c"); sts+=("$st"); stcs+=("$st_c")
    if (( ${#name} + ${#tags} > w_name )); then w_name=$(( ${#name} + ${#tags} )); fi
    if (( ${#st} > w_st )); then w_st=${#st}; fi
    if (( ${#ages[i]} > w_age )); then w_age=${#ages[i]}; fi
  done

  rows=()
  for (( i = 0; i < n; i++ )); do
    rows+=("${paths[i]}"$'\t'"${icons[i]} ${B}${names[i]}${R}${tagcs[i]}$(pad $(( w_name - ${#names[i]} - ${#tagss[i]} )))   ${stcs[i]}$(pad $(( w_st - ${#sts[i]} )))   ${GRY}$(pad $(( w_age - ${#ages[i]} )))${ages[i]}${R}   ${GRY}$(short_path "${paths[i]}")${R}")
  done
}

launch() {
  cd -- "$1" || die "cannot cd to $1"
  echo "${ACC}→${R} claude in ${B}$(tildify "$1")${R}" >&2
  if (( api )); then
    exec claude-api-env claude "${@:2}"
  fi
  exec claude "${@:2}"
}

# y/N from the terminal, not stdin: same reason fzf reads /dev/tty. Anything
# but y/yes is a no, EOF included.
confirm() {
  local answer
  printf '  %s?%s %s %s[y/N]%s ' "$YEL" "$R" "$1" "$GRY" "$R" >&2
  read -r answer </dev/tty || return 1
  [[ $answer == [yY] || $answer == [yY][eE][sS] ]]
}

# Sets `notice` (one coloured line for the next header) and never fails:
# every way out returns to the list.
delete() {
  local p=$1 i br='' err ign k line
  for (( i = 0; i < n; i++ )); do
    if [[ ${paths[i]} == "$p" ]]; then br=${branches[i]}; fi
  done
  if [[ $p == "$main_path" ]]; then
    notice="${RED}✗${R} $(tildify "$p") is the main worktree — git cannot remove it"
    return 0
  fi
  if [[ $p == "$here" ]]; then
    notice="${RED}✗${R} you are inside $(tildify "$p") — cd out of it first"
    return 0
  fi
  for (( i = 0; i < n; i++ )); do
    if [[ ${paths[i]} == "$p"/* ]]; then
      notice="${RED}✗${R} $(tildify "${paths[i]}") is a worktree inside $(tildify "$p") — delete that one first"
      return 0
    fi
  done

  printf '\n  %s%sDelete worktree%s %s%s%s\n  %s%s%s\n\n' \
    "$B" "$RED" "$R" "$B" "${br:-detached}" "$R" "$GRY" "$(tildify "$p")" "$R" >&2
  # Ignored entries, collapsed per directory the way `git status` shows them.
  ign=$(git --no-optional-locks -C "$p" status --porcelain --ignored 2>/dev/null \
    | sed -n 's/^!! //p' || true)
  if [[ -n $ign ]]; then
    printf '  %sIgnored, deleted with it without asking:%s\n' "$YEL" "$R" >&2
    k=0
    while IFS= read -r line; do
      k=$(( k + 1 ))
      if (( k <= 8 )); then printf '    %s%s%s\n' "$GRY" "$line" "$R" >&2; fi
    done <<<"$ign"
    if (( k > 8 )); then printf '    %s… %d more%s\n' "$GRY" $(( k - 8 )) "$R" >&2; fi
    echo >&2
  fi
  confirm "Remove it" || { notice="${GRY}kept $(tildify "$p")${R}"; return 0; }
  # git's refusal is shown (indented, in gray) because it is the reason the
  # next question is being asked.
  if ! err=$(git worktree remove -- "$p" 2>&1); then
    printf '    %s%s%s\n' "$GRY" "${err//$'\n'/$'\n'    }" "$R" >&2
    confirm "Force it? Uncommitted and untracked files in it are ${B}lost${R}, and a lock is ignored" \
      || { notice="${GRY}kept $(tildify "$p")${R}"; return 0; }
    if ! err=$(git worktree remove --force --force -- "$p" 2>&1); then
      notice="${RED}✗${R} could not remove $(tildify "$p") ${GRY}· ${err%%$'\n'*}${R}"
      return 0
    fi
  fi
  notice="${GRN}✓${R} removed $(tildify "$p")"
  if [[ -n $br ]] && confirm "Delete branch ${B}$br${R} too"; then
    # -d, never -D: git refuses an unmerged branch, and that refusal stands.
    if git branch -d -- "$br" >/dev/null 2>&1; then
      notice+=" and branch ${B}$br${R}"
    else
      notice+=" ${GRY}· kept branch $br (not fully merged)${R}"
    fi
  fi
  return 0
}

# ── fzf options, styled when the installed fzf can take them ─
fzf_opts=() styled=0
if command -v fzf >/dev/null 2>&1; then
  v=$(fzf --version 2>/dev/null || echo 0.0)
  v=${v%% *}
  major=${v%%.*} minor=${v#*.}
  minor=${minor%%.*}
  if [[ $major =~ ^[0-9]+$ && $minor =~ ^[0-9]+$ ]] && (( major > 0 || minor >= 42 )); then
    styled=1
  fi
  # The callback runs under fzf's $SHELL, so the path is quoted for it.
  self=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")
  fzf_opts=(
    --ansi --delimiter=$'\t' --with-nth=2..
    --expect=ctrl-d --no-multi --layout=reverse --header-first
    --prompt='❯ '
    --preview="$(printf '%q' "$self") --preview {1}"
    # Base `16` + no line block (bg+:-1), as FZF_DEFAULT_OPTS sets it; then
    # the accent in bright blue (12) and the chrome in gray (8).
    --color='16,bg+:-1,fg+:-1:bold,hl:3:bold,hl+:3:bold,prompt:12,pointer:12,info:8,header:7,spinner:12'
  )
  if (( styled )); then
    fzf_opts+=(
      --border=rounded '--padding=1,2' '--margin=1,2'
      --border-label-pos=3 --preview-label=' details ' --preview-label-pos=3
      --info=inline-right --pointer='▌' --separator='─' --scrollbar='│'
      --preview-window='right,45%,border-rounded,<56(down,60%,border-rounded)'
      --color='border:8,label:12:bold,preview-border:8,preview-label:7,separator:8,scrollbar:8'
    )
  else
    fzf_opts+=(--border --preview-window='right:50%:wrap')
  fi
fi

load
(( n > 0 )) || die "no worktree with a working directory in this repo"
repo=$(basename "$main_path")
notice=''

# ── the picker, until a launch or a cancel ───────────────────
# After a delete the list is re-read from git, not patched in place: what git
# reports is what was actually removed.
while :; do
  build_rows
  keys="${B}enter${R} ${GRY}claude${R}   ${B}ctrl-d${R} ${GRY}delete${R}   ${B}esc${R} ${GRY}quit${R}"
  header=$keys
  if [[ -n $notice ]]; then header="$notice"$'\n'"$keys"; fi
  count="$n worktree"
  if (( n != 1 )); then count+='s'; fi

  if (( ${#fzf_opts[@]} )); then
    # --expect prints the key that ended fzf on the first line (empty for
    # Enter), the picked row on the second. Status 1 (no match) and 130
    # (Esc / Ctrl-C) both mean nothing was picked and exit quietly; anything
    # else (2: no /dev/tty, an option this fzf rejects) is an error, said so.
    extra=(--header="$header")
    if (( styled )); then extra+=(--border-label=" ${repo} · ${count} "); fi
    rc=0
    out=$(printf '%s\n' "${rows[@]}" | fzf "${fzf_opts[@]}" "${extra[@]}") || rc=$?
    case $rc in
      0) ;;
      1 | 130) exit 130 ;;
      *) die "fzf failed (exit $rc)" ;;
    esac
    key=${out%%$'\n'*}
    pick=${out#*$'\n'}
    pick=${pick%%$'\t'*}
  else
    # ── fallback: numbered prompt ──────────────────────────────
    # Read from the terminal, like fzf does, so the prompt still works with
    # stdin redirected. Anything but a valid answer (Enter, q, Esc) cancels.
    printf '\n  %s%s%s %s· %s%s\n' "$B" "$repo" "$R" "$GRY" "$count" "$R" >&2
    if [[ -n $notice ]]; then printf '  %s\n' "$notice" >&2; fi
    echo >&2
    for (( i = 0; i < n; i++ )); do
      printf '  %s%2d%s  %s\n' "$GRY" "$((i + 1))" "$R" "${rows[i]#*$'\t'}" >&2
    done
    printf '\n  %s❯%s %s1-%d%s claude  %sd1-d%d%s delete  %sanything else%s quit: ' \
      "$ACC" "$R" "$B" "$n" "$R" "$B" "$n" "$R" "$B" "$R" >&2
    read -r answer </dev/tty || exit 130
    key=''
    if [[ $answer == d* ]]; then key=ctrl-d; answer=${answer#d}; fi
    # 10#: base 10, or `08` and `09` are invalid octal to bash.
    if ! [[ $answer =~ ^[0-9]+$ ]] || (( 10#$answer < 1 || 10#$answer > n )); then exit 130; fi
    pick=${paths[10#$answer - 1]}
  fi

  if [[ $key == ctrl-d ]]; then
    notice=''
    delete "$pick"
    load
    (( n > 0 )) || die "no worktree left with a working directory"
    continue
  fi
  launch "$pick" "$@"
done
