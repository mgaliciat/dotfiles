# Editor-agnostic whitespace rules (https://editorconfig.org). nvim reads this
# natively (0.9+), VS Code with the EditorConfig extension. It only covers what
# the repo has no formatter for: sh has no shfmt step, and lua is opted OUT of
# stylua by `.styluaignore` (hand-aligned tables) even though nvim has it on save.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.ps1]
indent_size = 4

[*.md]
# A trailing double space is a hard line break in Markdown.
trim_trailing_whitespace = false

# lazy.nvim owns this file; never reformat it by hand.
[nvim/lazy-lock.json]
insert_final_newline = false
