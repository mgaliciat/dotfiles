# dark-2026 — clone of "Dark 2026", VS Code's new default dark theme
# (the 2026 "Focus" refresh, default since 1.113 of March 25th
# 2026). Hex taken straight from
# extensions/theme-defaults/themes/2026-dark.json in microsoft/vscode
# (editor.background, focusBorder, tokenColors, etc.) — they're not a guess,
# they're the real values the editor ships. Dark companion of
# `light-2026` (same refresh, same extraction criteria).
# Mirror of nvim/lua/themes/dark-2026.lua and tmux/themes/dark-2026.conf.
#
# VS Code doesn't define a 16-color ANSI palette (its format is
# UI-chrome + tokenColors, not terminal), so the ANSI here is a
# reasoned construction out of those same hex — the same problem
# solarized-osaka.lua solved by looking at the plugin's `M.terminal()`.
# The repo's dark theme convention (see carbon/xcode-oled): the "brights"
# (8-15) are lighter/more vivid than the normals — standard ANSI
# convention, without inverting (that's only for the light themes).

# background and text — editor.background / editor.foreground
background = #121314
foreground = #bbbebf

# cursor — the teal-blue accent of the focusBorder/badge/menu family
# (menu.selectionBorder, without alpha), the theme's most iconic color
cursor-color = #3994bc
cursor-text  = #121314

# selection — editor.selectionBackground (#276782 at ~87% alpha) baked
# over the bg; foreground text stays readable on top
selection-background = #245c73
selection-foreground = #bbbebf

# ─── ANSI 16 ─────────────────────────────────────────────────
# normals (0-7) — base tones from tokenColors, without forcing saturation
palette = 0=#242526
palette = 1=#ff7b72
palette = 2=#7ee787
palette = 3=#e5ba7d
palette = 4=#79c0ff
palette = 5=#d2a8ff
palette = 6=#48a0c7
palette = 7=#8b949e

# brights (8-15): lighter/more vivid (standard dark convention)
palette = 8=#555555
palette = 9=#ffa198
palette = 10=#86cf86
palette = 11=#cca700
palette = 12=#57a3f8
palette = 13=#ad80d7
palette = 14=#53a5ca
palette = 15=#ffffff
