# solarized-osaka — deep-ocean Solarized from Japanese developer craftzdog.
# Deep blue-black (#001419) with solarized accents: signature magenta,
# violet, cyan, blue. Made for transparency + blur over a wallpaper,
# long sessions without fatigue. It's the "star" look of the family.
#
# Source of truth: the craftzdog/solarized-osaka.nvim plugin. The ANSI
# below is a LITERAL mirror of its `M.terminal()` (theme.lua) — what the
# plugin exports to `:terminal` inside nvim. FLAT mapping (not classic
# Solarized): brights == normals, no orange/violet in the ANSI, white = muted
# fg. That way Ghostty's shell and a `:terminal` in nvim look identical.
# If the plugin changes its palette/terminal, re-extract.

# background and text — bg = base04; fg = plugin Normal fg (hsl 186,8,55)
background = #001419
foreground = #839395

# cursor — solarized magenta (signature accent, matches incline.nvim and tmux)
cursor-color = #d23681
cursor-text  = #001419

# selection — base02 (barely lighter than the bg), fg aligned with the text
selection-background = #063540
selection-foreground = #839395

# ─── ANSI 16 ─────────────────────────────────────────────────
# Mirror of the plugin's M.terminal(). color_0/8 = darken(bg,0.8,#000) ≈ bg
# (pure "black" text almost blends into the background — upstream behavior).
# Brights 9-15 repeat their normals exactly; 7/15 = fg.
palette = 0=#001014
palette = 1=#db302d
palette = 2=#849900
palette = 3=#b28500
palette = 4=#268bd3
palette = 5=#d23681
palette = 6=#29a298
palette = 7=#839395

palette = 8=#001014
palette = 9=#db302d
palette = 10=#849900
palette = 11=#b28500
palette = 12=#268bd3
palette = 13=#d23681
palette = 14=#29a298
palette = 15=#839395
