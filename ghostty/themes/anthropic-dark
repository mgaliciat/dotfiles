# anthropic-dark — Claude.ai dark (charcoal ink + Claude orange).
# Mirror of nvim/lua/themes/anthropic-dark.lua. Palette normalized from
# the Anthropic brand-guidelines + docs.anthropic.com (WCAG-validated).
# Brand anchors: #D97757 orange (cursor), #141413 ink, #EAE7DF fg.

# background and text
background = #141413
foreground = #eae7df

# cursor — Claude orange (brand secondary)
cursor-color = #d97757
cursor-text  = #141413

# selection — bg inset + bright fg
selection-background = #2b2a27
selection-foreground = #f5f2e9

