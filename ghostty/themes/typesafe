# typesafe — the sage canvas of typesafe.ai + near-black ink. Mirror of
# nvim/lua/themes/typesafe.lua and tmux/themes/typesafe.conf.
#
# Source: the page's own CSS, read from the served HTML of
# https://typesafe.ai/blog/introducing-system-one-models-and-jev (2026-09-18):
#   html body { background: rgb(171, 186, 185) }   → #abbab9, the canvas
#   Framer colour tokens: #1e1e1e ink, #09aea1 teal, #03aa5c green,
#   #d45bb6 magenta, #f386a1 pink, #858585 gray, #dedede, #fefefe, #000.
# The canvas and the cursor teal are those values verbatim. Everything else is
# TUNED TO THE CANVAS in OKLCH (2026-09-18, second pass, same recipe as
# typesafe-dark): the page's tokens contribute their HUES only. The site is a
# Framer build with no 16-colour set and its accents sit at 1.2–1.8:1 over the
# canvas — fine for a button, unreadable as text — so lightness and chroma are
# set per role instead:
#   · normals (1-6)  L 0.43, C 0.10–0.15 (yellow 0.47, a yellow at 0.43 is
#     mud). 3.4–4.4:1 over the canvas — a mid-light canvas at L 0.777 caps
#     what a saturated colour can reach; going darker turns them all black.
#   · brights (8-15) L 0.34 (yellow 0.38). 5.0–6.3:1. 8 is the comment gray
#     at L 0.42, 4.2:1.
#   · every neutral (text, grays, the bg ladder) carries the canvas hue at a
#     small chroma instead of being pure black or gray.
#   · the bg ladder steps DOWN in even L: 0.777 (canvas) / 0.755 cursorline /
#     0.745 code bg / 0.705 selection / 0.665 hover.
# Yellow and blue have no page value at all and sit on the same grid.
#
# Light convention: the "brights" (8-15) are DARKER than the normals — more
# contrast over a light canvas, the reverse of the dark themes.
#
# WATCH OUT: unlike the other light themes this one runs `minimum-contrast = 1.1`
# in config.ghostty. Claude Code paints its spinner and accents in the brand
# colours by truecolor, and those sit at 1.1–1.8:1 over this canvas — at 3.0
# Ghostty rewrites them into dark mud. The palette here is tuned above 3:1 by
# construction, so it needs no enforcement.

# background and text — the page's canvas verbatim; text is a sage-tinted
# near-black (L 0.17, 9.5:1), not the pure #000 the first cut used and not the
# #1e1e1e ink. ANSI 15 is the darker of the two blacks.
background = #abbab9
foreground = #0a1110

# cursor — the site's teal accent (#09aea1 verbatim); black on top reads at 7.6:1.
# It is a block, not text, so it is the one accent that can stay at the page's L.
cursor-color = #09aea1
cursor-text  = #000000

# selection — the ladder two steps down, text stays at 7.4:1
selection-background = #94a4a3
selection-foreground = #0a1110

# ─── ANSI 16 ─────────────────────────────────────────────────
# normals (0-7) — 0 is a dark sage, a background tone rather than text
palette = 0=#2f3b3a
palette = 1=#901c32
palette = 2=#026031
palette = 3=#735601
palette = 4=#005581
palette = 5=#80246c
palette = 6=#065d55
palette = 7=#1a2120

# brights (8-15): DARKER (light theme). 8 is the comment gray.
palette = 8=#45504f
palette = 9=#6c0027
palette = 10=#004424
palette = 11=#533f03
palette = 12=#033c5b
palette = 13=#610951
palette = 14=#03413c
palette = 15=#020505
