# prism-night — palette sampled from the macOS "prism" wallpaper
# (deep night blue + spectrum arc: orange → yellow →
# green → cyan → blue → violet). Designed to go with
# transparency + blur over that specific wallpaper.

# background and text
background = #0a0e1a
foreground = #c8d3e8

# cursor (prism orange — high visibility over the blue-black bg)
cursor-color = #ff9248
cursor-text  = #0a0e1a

# selection (mid blue from the wallpaper, dark enough
# that white text stays readable on top)
selection-background = #2e4a7a
selection-foreground = #ffffff

# ─── ANSI 16 ─────────────────────────────────────────────────
# normals (0-7): prism tones, high saturation but without screaming
palette = 0=#1a2238
palette = 1=#ff6b5c
palette = 2=#a8d65c
palette = 3=#f5c842
palette = 4=#4a7ec8
palette = 5=#b06bd9
palette = 6=#5ec9d4
palette = 7=#c8d3e8

# brights (8-15): lifted +luminance versions of the normals
palette = 8=#3a4a6b
palette = 9=#ff8a7c
palette = 10=#c8e87a
palette = 11=#ffd866
palette = 12=#6b9ee0
palette = 13=#c98ae8
palette = 14=#7fd9e0
palette = 15=#ffffff
