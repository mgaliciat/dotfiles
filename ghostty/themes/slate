# slate — Tailwind's slate greys at night: a soft blue-grey canvas, not black,
# with Tailwind's own accents and no purple. Mirror of
# nvim/lua/themes/slate.lua.
#
# PROVENANCE: PORTED HEX, ASSEMBLED HERE. Every colour in this file is a swatch
# of the Tailwind CSS v3 default palette, copied verbatim from
# src/public/colors.js in the tailwindcss 3.4.17 package. No published terminal
# theme is built on it, so which swatch goes in which slot is this file's
# choice:
#   · canvas   — slate-900 #0f172a (OKLCH L 0.21, C 0.04, h 266), the canvas
#                Tailwind's own dark mode sits on. A blue-grey, not a near-black
#                (blueprint is L 0.145) and not a navy: the chroma is low enough
#                to read as grey.
#   · text     — slate-200 #e2e8f0, 14.5:1
#   · neutrals — the slate ladder itself, every grey carries the canvas hue
#   · accents  — Tailwind's 400s as the normals, their 300s as the brights
#   · magenta  — pink (h 350), not purple/violet/fuchsia: the rose family the
#                rest of the stack uses for that slot
#   · cyan     — cyan, and blue is blue: sky (h 233) sits between the two and
#                is kept for the accent, the cursor
#
# Contrast over the canvas, measured in sRGB:
#   · normals (1-6)  6.5–11.7:1 (red lowest, yellow highest)
#   · brights (9-14) 9.4–13.5:1
#   · 7 slate-300 12.0:1, 8 slate-500 3.8:1, 15 slate-100 16.3:1
# Measured in sRGB; `window-colorspace = display-p3` renders them more
# saturated.
#
# Dark convention: the "brights" (8-15) are LIGHTER than the normals.

background = #0f172a
foreground = #e2e8f0

# cursor — sky-400, the accent; the canvas on it 8.3:1
cursor-color = #38bdf8
cursor-text  = #0f172a

# selection — slate-700, two steps up the ladder; text on it 8.4:1
selection-background = #334155
selection-foreground = #e2e8f0

# ─── ANSI 16 ─────────────────────────────────────────────────
# normals (0-7) — 0 is slate-700, a background tone, not text.
palette = 0=#334155
palette = 1=#f87171
palette = 2=#4ade80
palette = 3=#facc15
palette = 4=#60a5fa
palette = 5=#f472b6
palette = 6=#22d3ee
palette = 7=#cbd5e1

# brights (8-15): LIGHTER (dark theme). 8 is slate-500 (3.8:1), the dim grey
# zsh's autosuggestions and Claude Code's subtle text are painted in: clearly a
# step below ANSI 7, and still over the 3:1 that `minimum-contrast` guards.
# nvim's comments are one step up, slate-400 (7.0:1).
#
# 12 stays a real bright blue (blue-300 #93c5fd, 9.9:1), so this file and
# nvim/lua/themes/slate.lua agree on every slot.
palette = 8=#64748b
palette = 9=#fca5a5
palette = 10=#86efac
palette = 11=#fde047
palette = 12=#93c5fd
palette = 13=#f9a8d4
palette = 14=#67e8f9
palette = 15=#f1f5f9
