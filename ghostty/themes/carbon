# carbon — minimal + functional, true black (#000) + a single warm accent.
# Cross-stack mirror: the same palette baked into nvim/lua/themes/carbon.lua
# and tmux/themes/carbon.conf (single source of truth = the canonical palette).
# Philosophy: high contrast over #000, neutral grays with no tint, and ONE
# accent (Claude orange #d97757) reused from the Anthropic Warm palette — without
# inventing other accent hexes. The grays carry the weight; the orange only
# marks focus (cursor).
#
# NOTE: with pure true black, consider lowering `minimum-contrast` to 1.0 if the
# grays look like they're glowing too much — the default enforcement over #000 is aggressive.

# background and text
background = #000000
foreground = #e4e4e4

# cursor — Claude orange, the palette's only accent. Warm and of maximum
# contrast over #000, it doesn't blend in with the text's neutral grays.
cursor-color = #d97757
cursor-text  = #000000

# selection — elevated mid gray (#2a2a2a) instead of a tint: consistent with
# the neutral aesthetic. Pure white fg keeps the selected text readable.
selection-background = #2a2a2a
selection-foreground = #ffffff

# ─── ANSI 16 ─────────────────────────────────────────────────
# normals (0-7): neutrals + desaturated functional colors (not neon).
# Enough chroma to tell syntax/git status apart, without vibrating over #000.
palette = 0=#1c1c1c
palette = 1=#e35f5f
palette = 2=#9ec07c
palette = 3=#d9a441
palette = 4=#7aa6c2
palette = 5=#c08fb8
palette = 6=#7fb5ad
palette = 7=#d4d4d4

# brights (8-15): lifted +luminance versions. bright_black uses a mid
# gray (#4a4a4a) that stays readable over #000 — it doesn't get swallowed like #2a2a2a.
palette = 8=#4a4a4a
palette = 9=#ef7a7a
palette = 10=#b3d196
palette = 11=#e8be6a
palette = 12=#9bc0d6
palette = 13=#d4a8cd
palette = 14=#9fccc4
palette = 15=#ffffff
