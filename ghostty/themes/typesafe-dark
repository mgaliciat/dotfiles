# typesafe-dark — the sage of typesafe.ai taken down to a night canvas. Mirror
# of nvim/lua/themes/typesafe-dark.lua and tmux/themes/typesafe-dark.conf.
# Dark companion of `typesafe`, built from the same page tokens.
#
# Source: the page's own CSS, read from the served HTML of
# https://typesafe.ai/blog/introducing-system-one-models-and-jev (2026-09-18):
#   html body { background: rgb(171, 186, 185) }   → #abbab9, hsl(176, 10%, 70%)
#   Framer colour tokens: #1e1e1e ink, #09aea1 teal, #03aa5c green,
#   #d45bb6 magenta, #f386a1 pink, #858585 gray, #dedede, #fefefe, #000.
# The page has no dark mode, so the canvas is DERIVED: the same hue, lightness
# 70% → 11%. Saturation is raised from the page's 10% to 17% on purpose — at
# that depth 10% reads as plain gray and the sage tint is the whole point.
#
# Everything else is TUNED TO THAT CANVAS in OKLCH (2026-09-18, second pass).
# The page's tokens contribute their HUES only; lightness and chroma are set
# per role so no slot pops or sinks against the others:
#   · normals (1-6)  L 0.70, C 0.12–0.15 — yellow at 0.76, a yellow at 0.70
#     reads as mustard. Contrast 5.7–7.5:1 over the canvas.
#   · brights (8-15) L 0.80, C 0.10–0.12 (yellow 0.86). 8.3–10.7:1.
#   · every neutral (text, grays, the bg ladder) carries the canvas hue at a
#     small chroma instead of being pure gray — pure gray on a teal-tinted
#     canvas reads pink by simultaneous contrast.
#   · the bg ladder climbs in even L steps: 0.20 / 0.242 (canvas) / 0.285 /
#     0.33 / 0.375, so code bg, cursorline, selection and hover are distinct
#     without any one of them jumping.
# The page's own hex are NOT in here verbatim any more — the first cut used
# them as-is and they were uneven (red at 4.5:1 beside yellow at 7.4:1).
#
# Dark convention: the "brights" (8-15) are LIGHTER than the normals.
#
# `minimum-contrast = 1.1` in config.ghostty is fine here: Claude Code's brand
# orange lands at 5.8:1 over this canvas, so nothing needs rescuing.

# background and text — the derived canvas; text is a sage-tinted white
# (L 0.90, 12.1:1), not the page's neutral #dedede, and not #fefefe, which
# glares on a canvas this dark. ANSI 15 is the brighter of the two whites.
background = #182221
foreground = #d8e0df

# cursor — the page's teal hue at the normals' L; black on top reads at 8.3:1
cursor-color = #17b6a8
cursor-text  = #000000

# selection — the canvas two steps up the ladder, text stays at 9.1:1
selection-background = #2b3837
selection-foreground = #d8e0df

# ─── ANSI 16 ─────────────────────────────────────────────────
# normals (0-7) — 0 is the ladder's top step, a background tone, not text
palette = 0=#364443
palette = 1=#ec737e
palette = 2=#42b970
palette = 3=#daa932
palette = 4=#50a7e2
palette = 5=#d977bf
palette = 6=#17b6a8
palette = 7=#cbd3d2

# brights (8-15): LIGHTER (dark theme). 8 is the comment gray, L 0.66 (5.3:1).
palette = 8=#8a9594
palette = 9=#fe9ead
palette = 10=#7ad59c
palette = 11=#f2cd6f
palette = 12=#80c7f8
palette = 13=#ef9fda
palette = 14=#69d3c7
palette = 15=#f1f6f6
