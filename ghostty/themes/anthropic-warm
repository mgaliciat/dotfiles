# anthropic-warm — dark theme built on the "Anthropic Warm" palette
# documented in CLAUDE.md (#d97757 Claude orange, #c8553d terracotta,
# #87a96b olive, #b08968 earth, #d9a441 amber). Warm charcoal background with
# a touch of brown instead of neutral black — made for long
# sessions with display-p3 + transparency, the warm complement to prism-night.

# background and text
# the bg leans towards a very dark brown (not neutral) so the warm palette doesn't
# look like it's "floating" over a cold background. Cream fg, not pure white, to
# lower eye strain in long sessions.
background = #1a1614
foreground = #e8dccc

# cursor — Claude orange straight up, maximum visibility over the charcoal bg
cursor-color = #d97757
cursor-text  = #1a1614

# selection — heavily darkened terracotta + bright fg. Enough contrast
# for selected text without saturating the view.
selection-background = #5a3a30
selection-foreground = #f5ede0

# ─── ANSI 16 ─────────────────────────────────────────────────
# normals (0-7): Anthropic warm palette + warm translations of
# blue/magenta/cyan (steel, rose dust, sage) to avoid garish colds.
palette = 0=#2a2420
palette = 1=#c8553d
palette = 2=#87a96b
palette = 3=#d9a441
palette = 4=#6b8e9e
palette = 5=#c97b8a
palette = 6=#8eb0a8
palette = 7=#c8b8a3

# brights (8-15): lifted +luminance versions. Bright red uses Claude
# orange (#d97757) — it vibrates like a "bright red" but stays inside the
# brand palette.
palette = 8=#4a3f38
palette = 9=#d97757
palette = 10=#a3c585
palette = 11=#e8c068
palette = 12=#8aaab8
palette = 13=#d99eac
palette = 14=#a8c8c0
palette = 15=#f5ede0
