# solarized-light — Ethan Schoonover's canonical Solarized Light.
# Mirror of nvim/lua/themes/solarized-light.lua and tmux/themes/solarized-light.conf.
#
# Palette = Solarized's official one (the same hex the repo's osaka family
# derives from, but here in its classic LIGHT form: base3 background, base00
# text). The ANSI 16 mapping is Solarized's canonical scheme — the
# "brights" (8-15) are the dark base tones (base03/base01/base00/base0),
# which over a light background give more contrast. It's not the dark convention.
#
# WATCH OUT: with a light theme consider raising `minimum-contrast` to 3.0 in
# config.ghostty (it rescues grays without distorting the accents).

# background and text
background = #fdf6e3
foreground = #657b83

# cursor — base01 (emphasized ink), high visibility over base3
cursor-color = #586e75
cursor-text  = #fdf6e3

# selection — base2, base01 text stays readable
selection-background = #eee8d5
selection-foreground = #586e75

# ─── ANSI 16 ─────────────────────────────────────────────────
# Canonical Solarized scheme. normals (0-7)
palette = 0=#073642
palette = 1=#dc322f
palette = 2=#859900
palette = 3=#b58900
palette = 4=#268bd2
palette = 5=#d33682
palette = 6=#2aa198
palette = 7=#eee8d5

# brights (8-15): dark base tones + orange/violet
palette = 8=#002b36
palette = 9=#cb4b16
palette = 10=#586e75
palette = 11=#657b83
palette = 12=#839496
palette = 13=#6c71c4
palette = 14=#93a1a1
palette = 15=#fdf6e3
