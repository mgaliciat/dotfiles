# naysayer — Jonathan Blow's editor colors (Emacs, later his own 4coder-derived one).
# Cross-stack mirror: the same palette baked into nvim/lua/themes/naysayer.lua
# and tmux/themes/naysayer.conf.
#
# Source of truth: his editor's own colour slots (Background, Default, Comment,
# Str_Constant, Int_Constant, Preproc, Cursor, Highlight, Bar, Margin, …), as
# reverse-engineered from his streams — https://vegard.wiki/w/Jon_Blow_emacs_colorscheme
# He never published a theme; the VS Code / nvim ports all descend from that table
# and each takes its own liberties. We mirror the table, not a port.
#
# SECONDARY source, corroborating only: `jblowtorch`, a builtin theme of Focus
# (the editor written in Jai) — config/themes/jblowtorch.focus-theme. It is Ivan
# Ivanov's reading, not Blow's own file, so it does NOT override a slot the table
# above defines. It converges independently on bg/fg/comment/cursor/selection,
# which is what earns it a vote on the slots the table simply has no colour for.
#
# The look: a deep teal bg (#052329) — not gray, not blue — with warm sand text
# and a green/teal syntax family. Comments are the BRIGHTEST thing on screen
# (#40C040), the inverse of every other theme's convention: he reads them.
# No bold, no italics anywhere.
#
# The palette moves on a visible 0x40/0x80/0xB0/0xC0/0xF0 grid. ANSI slots he has
# no colour for (red, blue, magenta) are derived ON that grid — see below.

# background and text
background = #052329
foreground = #d0c0a0

# cursor — his Cursor slot. Desaturated green, reads as "warm" over the teal bg.
cursor-color = #90c090
cursor-text  = #052329

# selection — his Highlight slot is literal #0010ff (pure blue). It is loud and
# it is authentic: keep it. White fg, since sand-on-blue is unreadable.
selection-background = #0010ff
selection-foreground = #ffffff

# ─── ANSI 16 ─────────────────────────────────────────────────
# normals (0-7). Where he has a slot, it's used verbatim. Red and magenta take
# Focus's observed values instead of a grid derivation — an observed hex beats a
# constructed one, and both land on slots ANSI actually uses: red is what a shell
# paints a diff deletion and an error with (jblowtorch's code_deletion), magenta
# is the only pink in the whole scheme (its code_number). Blue keeps its grid
# derivation: nothing in either source is a blue that isn't the selection.
palette = 0=#183848
palette = 1=#e64d4d
palette = 2=#40c040
palette = 3=#ffbb00
palette = 4=#4080c0
palette = 5=#d699b5
palette = 6=#40b0a0
palette = 7=#d0c0a0

# brights (8-15). bright_black is his Ghost_Character (#46494d) — already the
# slot for "present but inert" text, so it does the same job the shell asks of
# ANSI 8. bright_green/bright_cyan are Preproc and Int_Constant verbatim.
palette = 8=#46494d
palette = 9=#f08080
palette = 10=#b0ffb0
palette = 11=#ffd040
palette = 12=#80b0f0
palette = 13=#f0b0d0
palette = 14=#80f0e0
palette = 15=#f0e8d0
