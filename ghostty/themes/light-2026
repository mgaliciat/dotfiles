# light-2026 — clone of "2026 Light", VS Code's new default light theme
# (the 2026 "Focus" refresh, the same cycle that brought Dark 2026 as
# the default in 1.113). Hex taken straight from
# extensions/theme-defaults/themes/2026-light.json in microsoft/vscode
# (editor.background, focusBorder, tokenColors, etc.) — they're not a guess,
# they're the real values the editor ships.
# Mirror of nvim/lua/themes/light-2026.lua and tmux/themes/light-2026.conf.
#
# VS Code doesn't define a 16-color ANSI palette (its format is
# UI-chrome + tokenColors, not terminal), so the ANSI here is a
# reasoned construction out of those same hex — the same problem
# solarized-osaka.lua solved by looking at the plugin's `M.terminal()`.
# The repo's light theme convention (see paper/solarized-light): the
# "brights" (8-15) are more saturated/darker than the normals — they give
# more contrast over a white background.
#
# WATCH OUT: with this light theme, `minimum-contrast` in config.ghostty is
# already at 3.0 (it rescues grays without distorting the accent blue).

# background and text — editor.background / editor.foreground
background = #ffffff
foreground = #202020

# cursor — editorCursor.foreground + the accent blue (button.background
# / focusBorder), the theme's most iconic color
cursor-color = #0069cc
cursor-text  = #ffffff

# selection — editor.selectionBackground (#0069CC at 25% alpha) baked
# over white; foreground text stays readable on top
selection-background = #bfd9f2
selection-foreground = #202020

# ─── ANSI 16 ─────────────────────────────────────────────────
# normals (0-7) — base tones from tokenColors, without forcing saturation
palette = 0=#57606a
palette = 1=#cf222e
palette = 2=#116329
palette = 3=#667309
palette = 4=#0069cc
palette = 5=#8250df
palette = 6=#1b7c83
palette = 7=#6e7781

# brights (8-15): more saturated/darker (light theme)
palette = 8=#1f2328
palette = 9=#ad0707
palette = 10=#587c0c
palette = 11=#b69500
palette = 12=#1a5cff
palette = 13=#652d90
palette = 14=#145e63
palette = 15=#202020
