# oled-neon — true black (#000) + paleta neon estilo Dracula/synthwave.
# Diseñado para pantallas OLED (pixeles apagados = negro real + ahorro
# de batería) y para sesiones nocturnas donde el contraste máximo no
# molesta. Acentos saturados (verde láser, magenta neon, cyan brillante)
# que vibran sobre #000 sin necesidad de aumentar font weight.
#
# NOTA: con este theme, considerá bajar `minimum-contrast` a 1.0 si
# parece que los grays brillan más de la cuenta — el enforcement de
# 1.1 sobre #000 es agresivo.

# fondo y texto
background = #000000
foreground = #f8f8f2

# cursor — verde láser, máxima visibilidad sobre #000 (mucho más
# legible que magenta o cyan, que se mimetizan con texto colored).
cursor-color = #50fa7b
cursor-text  = #000000

# selección — azul-violeta oscuro (no gris medio Dracula original,
# que sobre #000 puro se ve "flotando"). Suficiente contraste con fg
# blanco para que el texto seleccionado siga legible.
selection-background = #2a2a4a
selection-foreground = #ffffff

# ─── ANSI 16 ─────────────────────────────────────────────────
# normales (0-7): paleta Dracula clásica adaptada. Nota: la spec ANSI
# 16 no tiene slot para "orange" (#ffb86c en Dracula extendido) — si
# necesitás orange en una app que use 256-color, queda fuera.
palette = 0=#1a1a1a
palette = 1=#ff5555
palette = 2=#50fa7b
palette = 3=#f1fa8c
palette = 4=#6272a4
palette = 5=#ff79c6
palette = 6=#8be9fd
palette = 7=#bfbfbf

# brillantes (8-15): versiones lifted +luminance. bright_black usa
# un gris medio (#4a4a4a) que sobre #000 sigue siendo legible — no
# desaparece como pasaría con #2a2a2a.
palette = 8=#4a4a4a
palette = 9=#ff6e6e
palette = 10=#69ff94
palette = 11=#ffffa5
palette = 12=#9eb0e0
palette = 13=#ff92df
palette = 14=#a4ffff
palette = 15=#ffffff
