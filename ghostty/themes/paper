# paper — light cream + sepia ink. Mirror of nvim/lua/themes/paper.lua
# and tmux/themes/paper.conf. Absorbs the old "anthropic-light".
# Light convention: the "brights" (8-15) are DARKER than the normals
# (more saturation = more contrast over a light background) — the reverse of the darks.
#
# WATCH OUT: with a light theme consider raising `minimum-contrast` to 3.0 in
# config.ghostty (it rescues grays without distorting the brand coral).

# background and text
background = #f5ead0
foreground = #2a1f15

# cursor — Claude coral, high visibility over cream
cursor-color = #d97757
cursor-text  = #f5ead0

# selection — toasted cream, sepia text stays readable
selection-background = #d4c298
selection-foreground = #2a1f15

# ─── ANSI 16 ─────────────────────────────────────────────────
# normals (0-7)
palette = 0=#3a2e1f
palette = 1=#b8493a
palette = 2=#6b8f4a
palette = 3=#c08a1e
palette = 4=#5a7a8e
palette = 5=#8a5a3f
palette = 6=#5a8a7e
palette = 7=#2a1f15

# brights (8-15): DARKER (light theme)
palette = 8=#7a6a55
palette = 9=#9a3520
palette = 10=#557030
palette = 11=#a07010
palette = 12=#456080
palette = 13=#70432f
palette = 14=#3f6f60
palette = 15=#1a1208
