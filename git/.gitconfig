; ═══════════════════════════════════════════════════════════════
;  git config global — M. Galicia
; ═══════════════════════════════════════════════════════════════

[user]
	name = M. Galicia
	email = 76408468+mgaliciat@users.noreply.github.com
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIEce3In0vIrtj9MdoEq52eDQRrkVUuI1Imf8k5yIFSgb

; ─── firma de commits con 1Password SSH agent ────────────────
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[commit]
	gpgsign = true

; ─── defaults sensatos ───────────────────────────────────────
[init]
	defaultBranch = main
[pull]
	rebase = true                 ; pull = rebase, no merge (history lineal)
[push]
	default = current             ; push asume rama actual = upstream
	autoSetupRemote = true        ; primer push crea upstream automáticamente
[fetch]
	prune = true                  ; limpia refs de branches eliminados en remote
[rebase]
	autoSquash = true             ; ! commits y squash! commits se reordenan solos
	autoStash = true              ; rebase auto-stasha cambios sin commitear
[merge]
	conflictStyle = zdiff3        ; muestra base común en conflicts (más útil)
[diff]
	algorithm = histogram         ; mejor que el default 'myers' para refactors
	colorMoved = default          ; código movido se muestra distinto a añadido
	mnemonicPrefix = true         ; usa i/ w/ c/ en vez de a/ b/ (más legible)
	renames = copies              ; detecta copias además de renames
[branch]
	sort = -committerdate         ; `git branch` ordena por reciente primero
[column]
	ui = auto                     ; muestra branches/tags en columnas

; ─── delta como pager (diffs con syntax highlighting) ────────
[core]
	pager = delta
	editor = nano                 ; cambia a 'code -w' / 'zed -w' / 'vim' si prefieres
	excludesfile = ~/.gitignore_global
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true               ; n/N para saltar entre archivos
	light = false                 ; tema dark
	line-numbers = true
	side-by-side = false          ; cambiar a true si trabajas en monitor ancho
	syntax-theme = base16

; ─── aliases ─────────────────────────────────────────────────
[alias]
	; status / log
	st = status -sb
	lg = log --oneline --graph --decorate --all -20
	last = log -1 HEAD --stat

	; staging
	a = add
	aa = add -A
	ap = add -p                   ; staging interactivo por hunk
	unstage = reset HEAD --

	; commit
	c = commit
	cm = commit -m
	amend = commit --amend --no-edit
	reword = commit --amend

	; branch
	b = branch
	co = checkout
	cb = checkout -b
	sw = switch
	br = branch -vv

	; diff
	d = diff
	ds = diff --staged

	; remote
	p = push
	pl = pull
	f = fetch --prune

	; rescate
	undo = reset --soft HEAD^      ; deshace último commit, mantiene cambios staged
	wip = !git add -A && git commit -m "wip"
	unwip = reset HEAD~

	; navegación
	root = rev-parse --show-toplevel
	cd-root = !cd $(git rev-parse --show-toplevel)

; ─── trailers ────────────────────────────────────────────────
[trailer "coauthored-by"]
	key = Co-Authored-By
