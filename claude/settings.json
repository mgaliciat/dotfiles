{
  "enabledPlugins": {
    "commit-commands@claude-plugins-official": true,
    "redash@redash": true,
    "forge@finance-plugin": true
  },
  "extraKnownMarketplaces": {
    "redash": {
      "source": {
        "source": "github",
        "repo": "cartografos/redash"
      }
    },
    "finance-plugin": {
      "source": {
        "source": "github",
        "repo": "cartografos/finance-plugin"
      }
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-ansi",
  "autoCompactEnabled": false,
  "permissions": {
    "allow": [
      "Bash(openspec *)"
    ]
  }
}
