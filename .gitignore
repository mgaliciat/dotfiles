.DS_Store
*.local
.zsh_history
.zcompdump*
*.backup.*

# Claude — mostly per-machine, never versioned. settings.json is 100% each
# machine's own (NOT symlinked, like ~/.gitconfig): permissions/UI config diverges
# per host and symlinking it would drag personal state into a public repo.
# memory/ isn't symlinked either (see install.sh). *.backup.* is already covered
# above.
#
# skills/ is per-machine (`learned`, `codebase-memory`, …) and nothing versioned
# lives under claude/skills/: the `logbook` plugin is in plugins/ because it is
# shared with Antigravity. The entry guards against a skill copied in by hand.
#
# RTK.md is rtk's own command reference. `rtk init` without `--hook-only` writes
# it to ~/.claude/ and imports it from ~/.claude/CLAUDE.md — a symlink to the
# versioned file. binaries.sh passes `--hook-only`, so nothing writes
# claude/RTK.md; this entry guards against somebody copying it in to "fix" a
# dangling import.
claude/settings.json
claude/memory/
claude/RTK.md
claude/skills/

# Git config — per-machine (each Mac has its own credentials, 1Password vaults,
# signing keys). Only .gitignore_global is versioned.
git/.gitconfig

# tmux-claude-hatch, cloned and pinned by install.sh into the linked ~/.config/tmux
tmux/plugins/

# Python wheels pulled in to run a linter locally; CI installs its own.
*.whl
