.DS_Store
*.local
.zsh_history
.zcompdump*
*.backup.*

# Claude — all per-machine, never versioned. settings.json is 100% each machine's
# own (NOT symlinked, like ~/.gitconfig): permissions/UI config diverges per host
# and was dragging personal state into a public repo. skills/ and memory/ aren't
# even symlinked anymore (see install.sh). *.backup.* is already covered by the
# rule above.
#
# The three entries stay here defensively anyway: if someone recreates the dir in
# the repo out of habit, git won't pick it up.
claude/settings.json
claude/memory/
claude/skills/

# Git config — per-machine (each Mac has its own credentials, 1Password vaults,
# signing keys). Only .gitignore_global is versioned.
git/.gitconfig

# tmux plugins (tpm + plugins are cloned at runtime by install.sh)
tmux/plugins/
