.DS_Store
*.local
.zsh_history
.zcompdump*
*.backup.*

# Claude — TODO per-máquina, no versionado. settings.json es 100% propio de
# cada máquina (NO symlinkeado, como ~/.gitconfig): config de permisos/UI
# diverge por host y arrastraba estado personal a un repo público. skills/
# se symlinkea sólo si existe localmente; memory/ ya ni se symlinkea (la
# maneja Claude Code per-proyecto). Backups *.backup.* ya cubiertos por la
# regla de arriba.
#
# codebase-memory/ (dentro de skills/) tampoco se versiona a propósito: la
# escribe/actualiza el propio binario codebase-memory-mcp (install -y y en
# runtime) — versionarla la dejaría desincronizada apenas el binario la
# reescriba con una versión nueva, y esa escritura caería silenciosamente
# sobre un archivo trackeado por git (skills/ es symlink al repo).
claude/settings.json
claude/memory/
claude/skills/

# Git config — per-máquina (cada Mac tiene credenciales, 1Password
# vaults, signing keys distintos). Solo .gitignore_global se versiona.
git/.gitconfig

# tmux plugins (tpm + plugins se clonan en runtime via install.sh)
tmux/plugins/
