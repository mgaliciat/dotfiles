.DS_Store
.zshenv.local
*.local
.zsh_history
.zcompdump*
*.backup.*

# Claude — skills/memorias per-máquina; settings.json es base portable
# versionada (sin secrets ni plugins privados). Lo per-máquina (plugins y
# marketplaces privados) vive en ~/.claude.json, no acá.
# Los backups settings.json.backup.* los cubre la regla *.backup.* de arriba.
claude/memory/
claude/skills/

# Git config — per-máquina (cada Mac tiene credenciales, 1Password
# vaults, signing keys distintos). Solo .gitignore_global se versiona.
git/.gitconfig

# tmux plugins (tpm + plugins se clonan en runtime via install.sh)
tmux/plugins/
